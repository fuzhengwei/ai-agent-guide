.reader-wrap {
  padding: 0 36rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  /* 与 app.wxss 一致的字体栈（页面级保障） */
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "HarmonyOS Sans SC", "MiSans", "OPPO Sans", "HONOR Sans", "Source Han Sans SC",
    "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  /* ===== 日间主题变量 ===== */
  --bg: #ffffff;
  --fg-title: #141a26;
  --fg-body: #333c4d;
  --fg-sub: #7d8798;
  --fg-soft: #8a94a3;
  --panel-bg: #f8fafc;
  --panel-border: #eef1f6;
  --head-bg: linear-gradient(135deg, #eef4ff 0%, #f6f4ff 100%);
  --quote-bg: #f7f9fc;
  --table-head-bg: #f0f4ff;
  color: var(--fg-body);
  background: var(--bg);
  transition: background 0.25s ease;
}

/* ===== 夜间主题（整页变量覆盖） ===== */
.reader-wrap.night {
  --bg: #14161c;
  --fg-title: #e8ecf4;
  --fg-body: #c3cad6;
  --fg-sub: #8f99ab;
  --fg-soft: #778193;
  --panel-bg: #1d212b;
  --panel-border: #2a303d;
  --head-bg: linear-gradient(135deg, #1c2333 0%, #201c33 100%);
  --quote-bg: #1b202a;
  --table-head-bg: #212839;
  background: var(--bg);
  color: var(--fg-body);
}

/* ================================================================
   字号连续调节
   原理：WXML 里节点类自带的固定字号（如 .nd-p{font-size:28rpx}）优先级
   低于下面 .fs-c .xx{font-size:var(--fs)} 的复合选择器，所以正文/列表/
   引用/问句会随 --fs 缩放；标题/代码/表格有自己的档位规则。
   ================================================================ */
.fs-c .nd-p, .fs-c .nd-li-txt, .fs-c .nd-quote, .fs-c .nd-chat-body {
  font-size: var(--fs, 28rpx);
}
/* 小节标题略大于正文 */
.fs-c .nd-h { font-size: calc(var(--fs, 28rpx) + 4rpx); }
.fs-c .nd-h.lv3 { font-size: calc(var(--fs, 28rpx) + 2rpx); }
.fs-c .nd-h.lv4 { font-size: var(--fs, 28rpx); }

/* 顶部阅读进度条 */
.read-progress { position: fixed; top: 0; left: 0; right: 0; height: 5rpx; background: transparent; z-index: 9; }
.read-progress-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #8b5cf6); border-radius: 0 999rpx 999rpx 0; transition: width 0.3s ease; }

/* ===== 阅读设置（悬浮按钮 + 弹出面板） ===== */
.reader-tools {
  position: fixed; right: 28rpx; bottom: 140rpx; z-index: 30;
  display: flex; flex-direction: column; gap: 20rpx;
}
.tool-btn {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: #ffffff; color: #4353c9;
  font-size: 30rpx; font-weight: 700; text-align: center; line-height: 84rpx;
  box-shadow: 0 6rpx 22rpx rgba(67, 83, 201, 0.22);
  border: 1rpx solid #e7ebf4;
}
.tool-btn.toc-btn { font-size: 32rpx; }
.tool-btn.share-btn { padding: 0; font-size: 32rpx; }
.tool-btn.share-btn::after { border: none; }
.night .tool-btn.share-btn { background: #232838; color: #a5b4fc; }
.tool-btn.on { background: #4353c9; color: #ffffff; }
.night .tool-btn { background: #232838; color: #a5b4fc; border-color: #2e3547; box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.5); }
.night .tool-btn.on { background: #4353c9; color: #ffffff; }

/* ===== 章节目录抽屉（右侧滑出） ===== */
.toc-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 44;
  background: rgba(15, 23, 42, 0.38);
}
.toc-panel {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 45;
  width: 76%; max-width: 600rpx;
  background: #ffffff; box-shadow: -12rpx 0 44rpx rgba(15, 23, 42, 0.16);
  display: flex; flex-direction: column;
  animation: toc-in 0.22s ease both;
}
@keyframes toc-in { from { transform: translateX(60rpx); opacity: 0.4; } to { transform: translateX(0); opacity: 1; } }
.night .toc-panel { background: #1d212b; box-shadow: -12rpx 0 44rpx rgba(0, 0, 0, 0.55); }
.toc-head {
  flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;
  padding: 34rpx 32rpx 22rpx; border-bottom: 1rpx solid #eef1f6;
}
.night .toc-head { border-bottom-color: #2a303d; }
.toc-title { font-size: 31rpx; font-weight: 700; color: var(--fg-title); }
.toc-close {
  width: 56rpx; height: 56rpx; border-radius: 50%; text-align: center; line-height: 56rpx;
  font-size: 26rpx; color: #8a94a3; background: #f1f4f9;
}
.night .toc-close { background: #262c3a; color: #9aa5b8; }
.toc-list { flex: 1; padding: 10rpx 0 40rpx; box-sizing: border-box; }
.toc-item {
  padding: 20rpx 32rpx; font-size: 27rpx; color: var(--fg-body); line-height: 1.55;
  border-left: 6rpx solid transparent;
}
.toc-item.lv3 { padding-left: 64rpx; font-size: 25rpx; color: var(--fg-sub); }
.toc-item:active { background: #eef1fb; border-left-color: #4353c9; color: #4353c9; }
.night .toc-item:active { background: #232c4a; color: #a5b4fc; }

/* ===== 回到上次阅读位置提示 ===== */
.resume-tip {
  position: fixed; top: 120rpx; left: 50%; transform: translateX(-50%); z-index: 50;
  background: rgba(20, 26, 38, 0.88); color: #ffffff;
  font-size: 24rpx; padding: 14rpx 32rpx; border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.3);
  animation: resume-in 0.28s ease both;
}
@keyframes resume-in { from { opacity: 0; transform: translate(-50%, -16rpx); } to { opacity: 1; transform: translate(-50%, 0); } }

.settings-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 39; background: transparent; }
.settings-panel {
  position: fixed; left: 36rpx; right: 36rpx; bottom: 250rpx; z-index: 40;
  background: #ffffff; border-radius: 22rpx;
  box-shadow: 0 12rpx 44rpx rgba(15, 23, 42, 0.18);
  padding: 14rpx 30rpx;
}
.night .settings-panel { background: #1d212b; box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.55); }
.set-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 1rpx solid #eef1f6;
}
.night .set-row { border-bottom-color: #2a303d; }
.set-row:last-child { border-bottom: none; }
.set-label { font-size: 27rpx; font-weight: 600; color: inherit; }
/* 字号步进按钮 */
.fs-opts { display: flex; align-items: center; gap: 16rpx; }
.fs-step {
  width: 64rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 999rpx; font-size: 28rpx; font-weight: 700;
  background: #f1f4f9; color: #4353c9; border: 2rpx solid transparent;
}
.fs-step:active { background: #eef1ff; border-color: #4353c9; }
.fs-step.dis { opacity: 0.35; }
.night .fs-step { background: #262c3a; color: #a5b4fc; }
.night .fs-step:active { background: #2a3350; border-color: #5a7cf7; }
.fs-value {
  min-width: 72rpx; text-align: center; font-size: 28rpx; font-weight: 700;
  color: #4353c9; font-variant-numeric: tabular-nums;
}
.night .fs-value { color: #a5b4fc; }
.set-hint { font-size: 22rpx; color: #9aa3b1; padding: 12rpx 0 4rpx; }
.night .set-hint { color: #6b7588; }

/* 章节头：底部细分隔线 + 面包屑（本书教程 › 第N章）+ 纯标题，书页式简洁风格 */
.reader-head {
  margin: 28rpx 0 20rpx;
  padding: 8rpx 2rpx 34rpx;
  border-bottom: 2rpx solid var(--panel-border);
}
.reader-bread {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 23rpx; font-weight: 600; letter-spacing: 2rpx;
  color: #7d92e8; margin-bottom: 18rpx;
}
.night .reader-bread { color: #93a8f2; }
.reader-bread-book { color: var(--fg-soft); font-weight: 500; }
.night .reader-bread-book { color: #778193; }
.reader-bread-sep { color: #c3cce0; font-weight: 400; }
.night .reader-bread-sep { color: #4a5470; }
.reader-title {
  font-size: 46rpx; font-weight: 800; color: var(--fg-title);
  line-height: 1.4; letter-spacing: 0.5rpx; word-break: break-word;
}
.reader-sub { font-size: 25rpx; color: var(--fg-sub); margin-top: 14rpx; line-height: 1.75; }

/* ================================================================
   正文节点样式（nd-*）。固定字号是兜底；真正生效的是上面 .fs-c 里的
   var(--fs) 规则（优先级更高），字号调节即时生效。
   ================================================================ */

/* 段落 */
.nd-p {
  font-size: 28rpx; line-height: 2.05; margin: 26rpx 0;
  color: var(--fg-body); letter-spacing: 0.4rpx;
  text-align: justify; word-break: break-word;
}

/* 章内大标题 */
.nd-h1 {
  font-size: 37rpx; font-weight: 700; color: var(--fg-title);
  margin: 72rpx 0 28rpx; line-height: 1.5; letter-spacing: 0.5rpx;
  word-break: break-word;
}
/* 小节标题（目录锚点节点） */
.nd-h {
  font-size: 32rpx; font-weight: 700; color: var(--fg-title);
  margin: 68rpx 0 26rpx; padding-left: 20rpx; border-left: 7rpx solid #4f6ef7;
  line-height: 1.5; letter-spacing: 0.5rpx; word-break: break-word;
}
.nd-h.lv3 { font-size: 29rpx; font-weight: 600; color: var(--fg-body); border-left: 5rpx solid #b9c6f9; margin: 54rpx 0 22rpx; padding-left: 18rpx; }
.nd-h.lv4 { font-size: 27rpx; font-weight: 600; color: var(--fg-body); border-left: 5rpx solid #d5dcfc; margin: 46rpx 0 20rpx; padding-left: 16rpx; }
.night .nd-h.lv3, .night .nd-h.lv4 { color: #d3dced; }

/* 引用 */
.nd-quote {
  background: var(--quote-bg); border-left: 6rpx solid #a9b6cc; border-radius: 0 14rpx 14rpx 0;
  padding: 26rpx 28rpx; margin: 32rpx 0; font-size: 27rpx; color: var(--fg-sub); line-height: 1.95;
}
.night .nd-quote { border-left-color: #4a5876; }

/* 列表 */
.nd-list { margin: 24rpx 0; }
.nd-li { display: flex; line-height: 1.95; color: var(--fg-body); margin: 16rpx 0; word-break: break-word; }
.nd-li-dot { flex-shrink: 0; width: 40rpx; color: #4f6ef7; font-weight: 700; }
.nd-li-txt { flex: 1; font-size: 28rpx; }

/* 代码块：mac 风格深色卡，独立 scroll-view 横滑，不拦截页面竖滑 */
.nd-codeblock {
  margin: 38rpx 0; border-radius: 18rpx;
  background: linear-gradient(180deg, #232a3b 0%, #1a2030 100%);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.18);
  border: 1rpx solid #2b3448;
}
.night .nd-codeblock { background: linear-gradient(180deg, #11151f 0%, #0d1017 100%); border-color: #262c3a; }
.nd-code-head {
  display: flex; align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  padding: 14rpx 22rpx;
}
.nd-code-dots { display: flex; }
.nd-code-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 10rpx; }
.nd-code-dot.d1 { background: #ff5f57; }
.nd-code-dot.d2 { background: #febc2e; }
.nd-code-dot.d3 { background: #28c840; }
.nd-code-lang { font-size: 20rpx; font-weight: 700; color: #8ea2c9; letter-spacing: 1.5rpx; margin-left: 14rpx; flex: 1; }
.nd-code-hint { font-size: 19rpx; color: #6d7a95; letter-spacing: 1rpx; }
.nd-code-scroll { width: 100%; }
.nd-code-body {
  display: inline-block; min-width: 100%;
  padding: 26rpx 28rpx 30rpx;
  color: #d6deeb;
  font-family: "SF Mono", Menlo, Consolas, "JetBrains Mono", monospace;
  font-size: 22rpx; line-height: 1.8; white-space: pre;
}

/* 表格：独立 scroll-view 横滑 + 清晰格线 */
.nd-table-scroll { width: 100%; margin: 30rpx 0; border-radius: 12rpx; }
.nd-table {
  display: inline-block; min-width: 100%;
  border: 1rpx solid #dde3ee; border-radius: 12rpx; overflow: hidden;
  background: #ffffff;
}
.night .nd-table { border-color: #2a303d; background: #171b25; }
.nd-tr { display: flex; }
.nd-td {
  flex-shrink: 0; min-width: 160rpx; padding: 16rpx 22rpx;
  font-size: 24rpx; color: var(--fg-body); line-height: 1.7;
  border-right: 1rpx solid #e6ebf4; border-bottom: 1rpx solid #e6ebf4;
  word-break: break-word; white-space: normal;
}
.nd-tr-head .nd-td {
  background: var(--table-head-bg); color: #5870ae; font-weight: 600;
  border-bottom: 2rpx solid #ccd6ea;
}
.night .nd-td { border-right-color: #262d3b; border-bottom-color: #262d3b; }
.night .nd-tr-head .nd-td { color: #93a8f2; border-bottom-color: #333c50; }

/* 信息卡：浅底壳 + 左侧强调条 */
.nd-card {
  background: var(--panel-bg); border-radius: 18rpx; padding: 30rpx 32rpx; margin: 32rpx 0;
  border: 1rpx solid var(--panel-border); border-left: 6rpx solid #d9e2ef;
}
.nd-card.mp-accent-success { border-left-color: #22c55e; }
.nd-card.mp-accent-warning { border-left-color: #f59e0b; }
.nd-card.mp-accent-error   { border-left-color: #ef4444; }
.nd-card.mp-accent-info    { border-left-color: #3b82f6; }
.nd-card.mp-accent-accent  { border-left-color: #6366f1; }
.nd-card-title { font-size: 27rpx; font-weight: 700; color: var(--fg-title); margin-bottom: 16rpx; }
.nd-card .nd-p { line-height: 1.9; margin: 14rpx 0; }
.nd-card .nd-list { margin: 14rpx 0 8rpx; }
.nd-card .nd-li { margin: 10rpx 0; }

/* 问答问句行 */
.nd-qaq {
  font-weight: 600; color: #4353c9; font-size: 27rpx;
  margin: 26rpx 0 10rpx; line-height: 1.75;
}
.night .nd-qaq { color: #93a8f6; }

/* 对话模拟气泡 */
.nd-chat {
  position: relative; margin: 22rpx 0; padding: 22rpx 24rpx 22rpx 30rpx;
  background: var(--panel-bg); border: 1rpx solid var(--panel-border);
  border-radius: 6rpx 20rpx 20rpx 20rpx; line-height: 1.85;
}
.nd-chat-label {
  display: inline-block; font-size: 21rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 999rpx; margin: 0 0 10rpx;
  letter-spacing: 0.5rpx;
}
.nd-chat.chat-user { border-left: 6rpx solid #4f6ef7; }
.nd-chat.chat-user .nd-chat-label { color: #4353c9; background: #eef1fb; }
.nd-chat.chat-thought { border-left: 6rpx solid #8b5cf6; }
.nd-chat.chat-thought .nd-chat-label { color: #7c3aed; background: #f3eefe; }
.nd-chat.chat-action { border-left: 6rpx solid #e8890c; }
.nd-chat.chat-action .nd-chat-label { color: #c26a00; background: #fef3e2; }
.nd-chat.chat-observe { border-left: 6rpx solid #0d9488; }
.nd-chat.chat-observe .nd-chat-label { color: #0f766e; background: #e6f7f5; }
.nd-chat.chat-reply { border-left: 6rpx solid #16a34a; }
.nd-chat.chat-reply .nd-chat-label { color: #15803d; background: #eaf8ef; }
.night .nd-chat { background: #141926; }
.night .nd-chat.chat-user .nd-chat-label { color: #9db1f7; background: #232c4a; }
.night .nd-chat.chat-thought .nd-chat-label { color: #c4a8f9; background: #2c2347; }
.night .nd-chat.chat-action .nd-chat-label { color: #f0b060; background: #3d2d14; }
.night .nd-chat.chat-observe .nd-chat-label { color: #5eead4; background: #10312e; }
.night .nd-chat.chat-reply .nd-chat-label { color: #6ee7a0; background: #10331f; }
.nd-chat .nd-p { margin: 10rpx 0; }

/* 竖向流程卡 */
.nd-flow {
  background: linear-gradient(180deg, #f8faff 0%, #f5f3ff 100%);
  border-radius: 20rpx; padding: 32rpx 28rpx; margin: 32rpx 0;
  border: 1rpx solid #e0e7ff;
}
.night .nd-flow { background: #1b2030; border-color: #2a303d; }
.nd-flow-card {
  border-radius: 14rpx; padding: 20rpx 26rpx; text-align: center;
  font-size: 25rpx; font-weight: 600; line-height: 1.6; margin: 0 auto; max-width: 86%;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.07);
}
.nd-flow-start { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #ffffff; }
.nd-flow-end { background: linear-gradient(135deg, #22c55e, #16a34a); color: #ffffff; }
.nd-flow-process { background: #ffffff; color: #1e293b; border: 2rpx solid #c7d2fe; }
.night .nd-flow-process { background: #262c3a; color: #dce3ef; border-color: #3a4256; }
.nd-flow-tool { background: linear-gradient(135deg, #f97316, #ea580c); color: #ffffff; }
.nd-flow-decision, .nd-flow-condition { background: linear-gradient(135deg, #f59e0b, #d97706); color: #ffffff; }
.nd-flow-memory { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #ffffff; }
.nd-flow-loop { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #ffffff; }
.nd-flow-branch { opacity: 0.85; }
.nd-flow-link { display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; }
.nd-flow-link-label {
  font-size: 20rpx; color: #5a6cd8; background: #eef1ff;
  border-radius: 999rpx; padding: 4rpx 20rpx; margin-bottom: 4rpx; font-weight: 600;
}
.night .nd-flow-link-label { color: #93a8f2; background: #262f4a; }
.nd-flow-link-arrow { color: #97a5ef; font-size: 26rpx; line-height: 1.2; font-weight: 700; }

/* 步骤列表 */
.nd-steps { margin: 30rpx 0; }
.nd-step { display: flex; margin-bottom: 24rpx; }
.nd-step-num {
  width: 48rpx; height: 48rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff;
  text-align: center; line-height: 48rpx; font-size: 22rpx; font-weight: 700;
  margin-right: 18rpx; margin-top: 3rpx;
}
.nd-step-body { flex: 1; }
.nd-step-title { font-size: 27rpx; font-weight: 600; color: var(--fg-title); line-height: 1.6; }
.nd-step-desc { font-size: 25rpx; color: var(--fg-sub); line-height: 1.85; margin-top: 8rpx; }

/* 左右对比卡 */
.nd-compare { display: flex; gap: 16rpx; margin: 32rpx 0; }
.nd-compare-side { flex: 1; border-radius: 14rpx; padding: 22rpx; }
.nd-compare-side:first-child { background: #f0f7ff; border: 1rpx solid #cfe3fb; }
.nd-compare-side:last-child { background: #fef4f4; border: 1rpx solid #f8d7d7; }
.night .nd-compare-side:first-child { background: #1a2436; border-color: #2a3850; }
.night .nd-compare-side:last-child { background: #2b1d20; border-color: #45282c; }
.nd-compare-label { font-size: 25rpx; font-weight: 700; margin-bottom: 12rpx; text-align: center; }
.nd-compare-side:first-child .nd-compare-label { color: #1d4ed8; }
.nd-compare-side:last-child .nd-compare-label { color: #b91c1c; }
.night .nd-compare-side:first-child .nd-compare-label { color: #7fa8f5; }
.night .nd-compare-side:last-child .nd-compare-label { color: #f08a8a; }
.nd-compare-line { font-size: 24rpx; line-height: 1.85; color: var(--fg-body); margin: 8rpx 0; }

/* 占位提示 */
.nd-note { background: #fffbeb; color: #92400e; border-radius: 12rpx; padding: 22rpx 26rpx; font-size: 25rpx; line-height: 1.75; }
.night .nd-note { background: #2b2416; color: #d9b47a; }

/* 章末闯关入口 */
.quiz-cta {
  display: flex; align-items: center; margin-top: 72rpx;
  background: linear-gradient(135deg, #1e1b4b, #6d28d9);
  border-radius: 20rpx; padding: 30rpx 32rpx; color: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(76, 29, 149, 0.28);
}
.cta-left { flex: 1; overflow: hidden; }
.cta-title { font-size: 28rpx; font-weight: 700; }
.cta-sub { font-size: 22rpx; opacity: 0.75; margin-top: 6rpx; }
.cta-btn {
  flex-shrink: 0; background: #fde047; color: #4c1d95;
  font-size: 25rpx; font-weight: 700; padding: 14rpx 32rpx; border-radius: 999rpx;
}

.reader-end { text-align: center; color: #8b95a6; font-size: 23rpx; margin: 60rpx 0 28rpx; letter-spacing: 1rpx; }
.night .reader-end { color: #5c6577; }

/* 底部导航 */
.reader-nav { display: flex; gap: 20rpx; }
.nav-btn { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; }
.nav-btn.prev { background: var(--panel-bg); color: var(--fg-body); border: 2rpx solid var(--panel-border); }
.nav-btn.next { background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff; box-shadow: 0 5rpx 18rpx rgba(67, 83, 201, 0.28); }
.nav-progress { text-align: center; font-size: 23rpx; color: #9aa3b1; margin-top: 18rpx; }
.night .nav-progress { color: #6b7588; }

/* ===== 收藏/笔记弹窗 ===== */
.fav-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 200; }
.fav-modal {
  position: fixed; left: 50%; top: 45%; transform: translate(-50%, -50%);
  width: 620rpx; max-width: 88vw; background: var(--panel-bg, #fff);
  border-radius: 24rpx; padding: 32rpx; z-index: 201;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.25);
}
.fav-quote {
  font-size: 24rpx; color: #8b95a6; line-height: 1.6;
  border-left: 6rpx solid #eab308; padding-left: 16rpx; margin-bottom: 20rpx;
  word-break: break-all;
}
.night .fav-quote { color: #9aa3b1; }
.fav-input {
  width: 100%; min-height: 140rpx; box-sizing: border-box;
  border: 2rpx solid var(--panel-border, #e5e7eb); border-radius: 14rpx;
  padding: 18rpx; font-size: 26rpx; color: var(--fg-body, #1f2937);
  background: var(--panel-bg, #fff);
}
.fav-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 22rpx; }
.fav-act {
  padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx;
  border: 2rpx solid var(--panel-border, #e5e7eb); color: var(--fg-body, #374151);
}
.fav-act.primary { background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #fff; border: none; }
.fav-btn { font-size: 34rpx; }

/* ===== 语音朗读 ===== */
.tool-btn.tts-btn { font-size: 30rpx; }
.tts-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 46; background: rgba(15, 23, 42, 0.38); }
.tts-panel {
  position: fixed; left: 36rpx; right: 36rpx; bottom: 250rpx; z-index: 47;
  background: #ffffff; border-radius: 22rpx;
  box-shadow: 0 12rpx 44rpx rgba(15, 23, 42, 0.22);
  padding: 24rpx 30rpx 20rpx;
  animation: toc-in 0.22s ease both;
}
.night .tts-panel { background: #1d212b; box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.55); }
.tts-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 18rpx; border-bottom: 1rpx solid #eef1f6;
  margin-bottom: 18rpx;
}
.night .tts-head { border-bottom-color: #2a303d; }
.tts-title { font-size: 30rpx; font-weight: 700; color: var(--fg-title); }
.tts-close {
  width: 52rpx; height: 52rpx; border-radius: 50%; text-align: center; line-height: 52rpx;
  font-size: 24rpx; color: #8a94a3; background: #f1f4f9;
}
.night .tts-close { background: #262c3a; color: #9aa5b8; }
.tts-row { margin-bottom: 20rpx; }
.tts-label { font-size: 25rpx; font-weight: 600; color: var(--fg-body); margin-bottom: 12rpx; }
.tts-voices { display: flex; gap: 14rpx; }
.voice-opt {
  flex: 1; text-align: center; padding: 14rpx 8rpx;
  background: #f1f4f9; border: 2rpx solid transparent; border-radius: 14rpx;
  font-size: 24rpx; color: #5b6675;
}
.voice-opt.on { background: #eef1ff; border-color: #4353c9; color: #4353c9; }
.night .voice-opt { background: #262c3a; color: #9aa5b8; }
.night .voice-opt.on { background: #2a3350; border-color: #5a7cf7; color: #a5b4fc; }
.voice-name { font-weight: 700; font-size: 25rpx; }
.voice-desc { font-size: 20rpx; opacity: 0.75; margin-top: 4rpx; }
.tts-rate-val { min-width: 64rpx; text-align: center; font-size: 26rpx; font-weight: 700; color: #4353c9; font-variant-numeric: tabular-nums; }
.night .tts-rate-val { color: #a5b4fc; }
.tts-controls { display: flex; gap: 14rpx; margin: 20rpx 0 14rpx; }
.tts-ctl-btn {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  font-size: 26rpx; font-weight: 600;
  background: #f1f4f9; color: #4353c9; border: 2rpx solid transparent;
}
.tts-ctl-btn.primary { background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff; box-shadow: 0 4rpx 14rpx rgba(67, 83, 201, 0.3); }
.tts-ctl-btn.stop { background: #fee2e2; color: #dc2626; }
.night .tts-ctl-btn { background: #262c3a; color: #a5b4fc; }
.night .tts-ctl-btn.primary { background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff; }
.night .tts-ctl-btn.stop { background: #3a2121; color: #f87171; }
.tts-status { font-size: 23rpx; color: #8a94a3; text-align: center; padding: 4rpx 0 8rpx; }
.tts-hint { font-size: 21rpx; color: #9aa3b1; line-height: 1.6; padding-top: 10rpx; border-top: 1rpx dashed #eef1f6; }
.night .tts-hint { color: #6b7588; border-top-color: #2a303d; }
.tts-unsupported { font-size: 25rpx; color: #9aa3b1; text-align: center; padding: 30rpx 10rpx; line-height: 1.8; }
