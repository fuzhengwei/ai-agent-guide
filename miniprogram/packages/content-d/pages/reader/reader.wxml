<view class="reader-wrap {{nightMode ? 'night' : ''}} {{selectable ? 'selectable-on' : ''}}">

  <!-- 顶部阅读进度条 -->
  <view class="read-progress">
    <view class="read-progress-fill" style="width: {{progress}}%"></view>
  </view>

  <!-- 已回到上次阅读位置提示 -->
  <view class="resume-tip" wx:if="{{resumeTip}}">📖 已回到上次阅读位置</view>

  <!-- 悬浮工具：分享 + 收藏 + 目录 + 朗读 + 阅读设置 -->
  <view class="reader-tools">
    <button class="tool-btn share-btn" open-type="share">↗</button>
    <view class="tool-btn fav-btn" bindtap="onFavTap" bindlongpress="onFavHelp">☆</view>
    <view class="tool-btn toc-btn {{tocOpen ? 'on' : ''}}" wx:if="{{toc.length}}" bindtap="toggleToc">☰</view>
    <view class="tool-btn tts-btn {{ttsState !== 'idle' ? 'on' : ''}}" bindtap="toggleTtsPanel">
      <block wx:if="{{ttsState === 'idle'}}">🔊</block>
      <block wx:elif="{{ttsState === 'synthesizing'}}">⏳</block>
      <block wx:elif="{{ttsState === 'paused'}}">⏸</block>
      <block wx:else>🔊</block>
    </view>
    <view class="tool-btn" bindtap="togglePanel">Aa</view>
  </view>

  <!-- 章节目录抽屉 -->
  <view class="toc-mask" wx:if="{{tocOpen}}" bindtap="toggleToc"></view>
  <view class="toc-panel {{tocOpen ? 'open' : ''}}" wx:if="{{tocOpen}}">
    <view class="toc-head">
      <view class="toc-title">本章目录</view>
      <view class="toc-close" bindtap="toggleToc">✕</view>
    </view>
    <scroll-view class="toc-list" scroll-y scroll-into-view="{{tocAnchor}}" scroll-with-animation>
      <view id="toc-top-{{tocStamp}}"></view>
      <view
        wx:for="{{toc}}"
        wx:key="anchor"
        id="{{item.anchor}}"
        class="toc-item lv{{item.level}}"
        data-anchor="{{item.anchor}}"
        bindtap="tapTocItem"
      >{{item.text}}</view>
    </scroll-view>
  </view>

  <!-- 阅读设置面板 -->
  <view class="settings-mask" wx:if="{{panelOpen}}" bindtap="togglePanel"></view>
  <view class="settings-panel {{panelOpen ? 'open' : ''}}" wx:if="{{panelOpen}}">
    <view class="set-row">
      <view class="set-label">夜间模式</view>
      <switch checked="{{nightMode}}" bindchange="toggleNight" color="#5a7cf7" />
    </view>
    <view class="set-row">
      <view class="set-label">字号</view>
      <view class="fs-opts">
        <view class="fs-step {{fontSize <= 22 ? 'dis' : ''}}" bindtap="stepFont" data-dir="-1">A−</view>
        <view class="fs-value">{{fontSize}}</view>
        <view class="fs-step {{fontSize >= 38 ? 'dis' : ''}}" bindtap="stepFont" data-dir="1">A＋</view>
      </view>
    </view>
    <view class="set-hint">范围 22 ~ 38，当前 {{fontPercent}}%，自动保存</view>
    <view class="set-row">
      <view class="set-label">文本选择</view>
      <switch checked="{{selectable}}" bindchange="toggleSelectable" color="#5a7cf7" />
    </view>
    <view class="set-hint">开启后长按正文可选中复制；复制后点 ☆ 收藏/写笔记。关闭时改为长按弹出收藏菜单</view>
  </view>

  <!-- 朗读面板（底部抽屉，内容超出可滚动） -->
  <view class="tts-mask" wx:if="{{ttsPanelOpen}}" bindtap="toggleTtsPanel"></view>
  <view class="tts-panel" wx:if="{{ttsPanelOpen}}" catchtouchmove="noop">
    <view class="tts-grabber"></view>
    <view class="tts-head">
      <view class="tts-title">🔊 语音朗读</view>
      <view class="tts-close" bindtap="toggleTtsPanel">✕</view>
    </view>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="tts-scroll">
      <view class="tts-body" wx:if="{{ttsSupported}}">
        <view class="tts-row">
          <view class="tts-label">音色 <text class="tts-label-sub">· 点卡片选中，点试听小圆钮试听</text></view>
          <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tts-voices">
            <view
              wx:for="{{voices}}"
              wx:key="id"
              class="voice-opt {{ttsVoice === item.id ? 'on' : ''}}"
              data-id="{{item.id}}"
              bindtap="setVoice"
            >
              <view class="voice-emoji">{{item.emoji}}</view>
              <view class="voice-name">{{item.label}}</view>
              <view class="voice-desc">{{item.desc}}</view>
              <view
                class="voice-try {{previewingVoice === item.id ? 'ing' : ''}}"
                catchtap="previewVoice"
                data-id="{{item.id}}"
              >{{previewingVoice === item.id ? '●' : '▶'}}</view>
            </view>
          </scroll-view>
        </view>
        <view class="tts-row">
          <view class="tts-label">语速 <text class="tts-label-sub">· {{ttsRate}}x</text></view>
          <slider min="0.6" max="1.8" step="0.1" value="{{ttsRate}}" activeColor="#5a7cf7" block-size="18" bindchanging="onRateChanging" bindchange="onRateChange" />
        </view>
        <view class="tts-row">
          <view class="tts-label">定时停止</view>
          <view class="tts-timer-opts">
            <view
              wx:for="{{timerOptions}}"
              wx:key="id"
              class="timer-opt {{ttsTimer === item.id ? 'on' : ''}}"
              data-id="{{item.id}}"
              bindtap="setTimer"
            >{{item.label}}</view>
          </view>
        </view>
        <view class="tts-timer-info" wx:if="{{ttsTimer !== 'none' && timerCountdownText}}">⏰ {{timerCountdownText}}</view>
        <view class="tts-controls">
          <view class="tts-ctl-btn primary" bindtap="ttsPlay" wx:if="{{ttsState === 'idle'}}">▶ 朗读本章</view>
          <view class="tts-ctl-btn" bindtap="ttsPause" wx:if="{{ttsState === 'playing' || ttsState === 'synthesizing'}}">⏸ 暂停</view>
          <view class="tts-ctl-btn primary" bindtap="ttsResume" wx:if="{{ttsState === 'paused'}}">▶ 继续</view>
          <view class="tts-ctl-btn stop" bindtap="ttsStop" wx:if="{{ttsState !== 'idle'}}">⏹ 停止</view>
        </view>
        <view class="tts-status" wx:if="{{ttsState !== 'idle'}}">
          {{ttsState === 'synthesizing' ? '合成中…' : '正在朗读 ' + (ttsIndex + 1) + ' / ' + ttsTotal + ' 段'}}
        </view>
        <view class="tts-hint">朗读时当前段落会高亮变色并自动滚动跟随；离开本章自动停止</view>
      </view>
      <view class="tts-body" wx:else>
        <view class="tts-unsupported">
          朗读服务需要云开发环境。<br/>请确认已开通云开发并部署 tts 云函数。
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 章节头：「本书教程 › 第N章」面包屑 + 纯标题（序号不再重复出现在标题里） -->
  <view class="reader-head">
    <view class="reader-bread" wx:if="{{chapterNum !== ''}}">
      <text class="reader-bread-book">本书教程</text>
      <text class="reader-bread-sep">›</text>
      <text class="reader-bread-num">第 {{chapterNum}} 章</text>
    </view>
    <view class="reader-title" selectable="{{selectable}}" data-text="{{titleMain || title}}" bindlongpress="onNodeLongPress">{{titleMain || title}}</view>
    <view class="reader-sub" wx:if="{{subtitle}}" selectable="{{selectable}}" data-text="{{subtitle}}" bindlongpress="onNodeLongPress">{{subtitle}}</view>
  </view>

  <!--
    正文渲染（不再用 rich-text，改用节点树 + WXML 递归模板）：
    - 页面原生纵向滚动不再被拦截（原 rich-text catchtouchmove 会吃掉竖滑）
    - 字号用 WXML 样式优先级规则控制：构建期不再给正文标签写死字号，
      下面 .fs-c 的选择器优先级高于 WXML 模板里的固定字号，自然随 --fs 缩放
    - 标题锚点是真实 view 节点，目录点击可 createSelectorQuery 定位跳转
    - 代码块/表格是独立 scroll-view，可各自横滑，互不干扰
  -->
  <view class="fs-c" style="--fs: {{fontSize}}rpx;">
    <block wx:for="{{nodes}}" wx:key="index">
      <!-- 段落 -->
      <view wx:if="{{item.type === 'p'}}" class="nd-p fs-z {{ttsState !== 'idle' && ttsIndex === item.tts ? 'tts-live' : ''}}" data-tts-idx="{{item.tts}}" selectable="{{selectable}}" data-text="{{item.text}}" bindlongpress="onNodeLongPress">{{item.text}}</view>
      <!-- 小节标题（目录锚点：真实节点 id，可 scroll 定位） -->
      <view wx:elif="{{item.type === 'h'}}" id="{{item.anchor}}" class="nd-h lv{{item.level}} {{ttsState !== 'idle' && ttsIndex === item.tts ? 'tts-live' : ''}}" data-tts-idx="{{item.tts}}" selectable="{{selectable}}" data-text="{{item.text}}" bindlongpress="onNodeLongPress">{{item.text}}</view>
      <!-- 引用 -->
      <view wx:elif="{{item.type === 'quote'}}" class="nd-quote fs-z {{ttsState !== 'idle' && ttsIndex === item.tts ? 'tts-live' : ''}}" data-tts-idx="{{item.tts}}" selectable="{{selectable}}" data-text="{{item.text}}" bindlongpress="onNodeLongPress">{{item.text}}</view>
      <!-- 列表 -->
      <view wx:elif="{{item.type === 'list'}}" class="nd-list">
        <view wx:for="{{item.items}}" wx:for-item="li" wx:key="index" class="nd-li fs-z {{ttsState !== 'idle' && ttsIndex === li.tts ? 'tts-live' : ''}}" data-tts-idx="{{li.tts}}">
          <text class="nd-li-dot">{{item.ordered ? (index + 1) + '.' : '•'}}</text>
          <text class="nd-li-txt" selectable="{{selectable}}" data-text="{{li.text}}" bindlongpress="onNodeLongPress">{{li.text}}</text>
        </view>
      </view>
      <!-- 代码块（独立横滑） -->
      <view wx:elif="{{item.type === 'code'}}" class="nd-codeblock">
        <view class="nd-code-head">
          <view class="nd-code-dots">
            <view class="nd-code-dot d1"></view>
            <view class="nd-code-dot d2"></view>
            <view class="nd-code-dot d3"></view>
          </view>
          <view class="nd-code-lang" wx:if="{{item.lang}}">{{item.lang}}</view>
          <view class="nd-code-hint">‹ 左右滑动 ›</view>
        </view>
        <scroll-view scroll-x class="nd-code-scroll" enhanced show-scrollbar="{{false}}">
          <view class="nd-code-body">{{item.code}}</view>
        </scroll-view>
      </view>
      <!-- 表格（独立横滑） -->
      <scroll-view wx:elif="{{item.type === 'table'}}" scroll-x class="nd-table-scroll" enhanced show-scrollbar="{{false}}">
        <view class="nd-table">
          <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="index" class="nd-tr {{row.head ? 'nd-tr-head' : ''}}">
            <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="nd-td">{{cell}}</view>
          </view>
        </view>
      </scroll-view>
      <!-- 信息卡 -->
      <view wx:elif="{{item.type === 'card'}}" class="nd-card {{item.accent}} {{item.qa ? 'nd-qa' : ''}}">
        <view class="nd-card-title" wx:if="{{item.title}}">{{item.title}}</view>
        <block wx:for="{{item.children}}" wx:for-item="c" wx:key="index">
          <view wx:if="{{c.type === 'p'}}" class="nd-p fs-z {{ttsState !== 'idle' && ttsIndex === c.tts ? 'tts-live' : ''}}" data-tts-idx="{{c.tts}}" selectable="{{selectable}}" data-text="{{c.text}}" bindlongpress="onNodeLongPress">{{c.text}}</view>
          <view wx:elif="{{c.type === 'quote'}}" class="nd-quote fs-z {{ttsState !== 'idle' && ttsIndex === c.tts ? 'tts-live' : ''}}" data-tts-idx="{{c.tts}}" selectable="{{selectable}}" data-text="{{c.text}}" bindlongpress="onNodeLongPress">{{c.text}}</view>
          <view wx:elif="{{c.type === 'list'}}" class="nd-list">
            <view wx:for="{{c.items}}" wx:for-item="li" wx:key="index" class="nd-li fs-z">
              <text class="nd-li-dot">{{c.ordered ? (index + 1) + '.' : '•'}}</text>
              <text class="nd-li-txt" selectable="{{selectable}}" data-text="{{li.text}}" bindlongpress="onNodeLongPress">{{li.text}}</text>
            </view>
          </view>
        </block>
      </view>
      <!-- 问答问句行 -->
      <view wx:elif="{{item.type === 'qaq'}}" class="nd-qaq fs-z {{ttsState !== 'idle' && ttsIndex === item.tts ? 'tts-live' : ''}}" data-tts-idx="{{item.tts}}" selectable="{{selectable}}" data-text="{{item.text}}" bindlongpress="onNodeLongPress">{{item.text}}</view>
      <!-- 对话模拟气泡 -->
      <view wx:elif="{{item.type === 'chat'}}" class="nd-chat {{item.tone}}">
        <view class="nd-chat-label" wx:if="{{item.label}}">{{item.label}}</view>
        <block wx:for="{{item.children}}" wx:for-item="c" wx:key="index">
          <view wx:if="{{c.type === 'p'}}" class="nd-p fs-z {{ttsState !== 'idle' && ttsIndex === c.tts ? 'tts-live' : ''}}" data-tts-idx="{{c.tts}}" selectable="{{selectable}}" data-text="{{c.text}}" bindlongpress="onNodeLongPress">{{c.text}}</view>
          <view wx:elif="{{c.type === 'list'}}" class="nd-list">
            <view wx:for="{{c.items}}" wx:for-item="li" wx:key="index" class="nd-li fs-z">
              <text class="nd-li-dot">{{c.ordered ? (index + 1) + '.' : '•'}}</text>
              <text class="nd-li-txt" selectable="{{selectable}}" data-text="{{li.text}}" bindlongpress="onNodeLongPress">{{li.text}}</text>
            </view>
          </view>
        </block>
      </view>
      <!-- 竖向流程卡 -->
      <view wx:elif="{{item.type === 'flow'}}" class="nd-flow">
        <block wx:for="{{item.steps}}" wx:for-item="s" wx:key="index">
          <view wx:if="{{index > 0}}" class="nd-flow-link">
            <view class="nd-flow-link-label" wx:if="{{s.edge}}">{{s.edge}}</view>
            <view class="nd-flow-link-arrow">↓</view>
          </view>
          <view class="nd-flow-card nd-flow-{{s.kind}} {{s.branch ? 'nd-flow-branch' : ''}}">{{s.label}}</view>
        </block>
      </view>
      <!-- 步骤列表 -->
      <view wx:elif="{{item.type === 'steps'}}" class="nd-steps">
        <view wx:for="{{item.items}}" wx:for-item="s" wx:key="index" class="nd-step">
          <view class="nd-step-num">{{s.num}}</view>
          <view class="nd-step-body">
            <view class="nd-step-title">{{s.title}}</view>
            <view class="nd-step-desc" wx:if="{{s.desc}}">{{s.desc}}</view>
          </view>
        </view>
      </view>
      <!-- 左右对比卡 -->
      <view wx:elif="{{item.type === 'compare'}}" class="nd-compare">
        <view wx:for="{{item.sides}}" wx:for-item="side" wx:key="index" class="nd-compare-side">
          <view class="nd-compare-label">{{side.label}}</view>
          <view wx:for="{{side.lines}}" wx:for-item="ln" wx:key="index" class="nd-compare-line">{{ln}}</view>
        </view>
      </view>
      <!-- 占位提示 -->
      <view wx:elif="{{item.type === 'note'}}" class="nd-note">{{item.text}}</view>
    </block>
  </view>

  <!-- 收藏/笔记输入弹窗 -->
  <view class="fav-mask" wx:if="{{favModal}}" bindtap="closeFavModal"></view>
  <view class="fav-modal" wx:if="{{favModal}}">
    <view class="fav-quote">"{{favTextPreview}}"</view>
    <textarea class="fav-input" placeholder="写点笔记…（可不填，直接收藏）" value="{{favNoteInput}}" bindinput="onFavNoteInput" maxlength="500" auto-height />
    <view class="fav-actions">
      <view class="fav-act" bindtap="closeFavModal">取消</view>
      <view class="fav-act primary" bindtap="saveFav">{{favNoteInput ? '收藏+笔记' : '收藏'}}</view>
    </view>
  </view>

  <!-- 章末：去面试 -->
  <view class="quiz-cta" wx:if="{{quizKey}}" bindtap="goQuiz">
    <view class="cta-left">
      <view class="cta-title">🎤 学完了？来面一场</view>
      <view class="cta-sub">本章配套模拟面试 · 面试官现场点评</view>
    </view>
    <view class="cta-btn">去面试</view>
  </view>

  <view class="reader-end">— 本章完 · 已自动记录阅读进度 —</view>

  <view class="reader-nav">
    <view class="nav-btn prev" bindtap="goPrev">← 上一章</view>
    <view class="nav-btn next" bindtap="goNext">{{finished ? '完成' : '下一章 →'}}</view>
  </view>
  <view class="nav-progress">{{currentIndex + 1}} / {{total}}</view>
</view>
