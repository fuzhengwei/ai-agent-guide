.reader-wrap {
  padding: 0 36rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  /* 与 app.wxss 一致的字体栈（页面级保障） */
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "HarmonyOS Sans SC", "MiSans", "OPPO Sans", "HONOR Sans", "Source Han Sans SC",
    "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  /* ===== 日间主题变量 ===== */
  --bg: #ffffff;
  --fg-title: #141a26;
  --fg-body: #333c4d;
  --fg-sub: #7d8798;
  --fg-soft: #8a94a3;
  --panel-bg: #f8fafc;
  --panel-border: #eef1f6;
  --head-bg: linear-gradient(135deg, #eef4ff 0%, #f6f4ff 100%);
  --quote-bg: #f7f9fc;
  --table-head-bg: #f0f4ff;
  color: var(--fg-body);
  background: var(--bg);
  transition: background 0.25s ease;
}

/* ===== 夜间主题（整页变量覆盖） ===== */
.reader-wrap.night {
  --bg: #14161c;
  --fg-title: #e8ecf4;
  --fg-body: #c3cad6;
  --fg-sub: #8f99ab;
  --fg-soft: #778193;
  --panel-bg: #1d212b;
  --panel-border: #2a303d;
  --head-bg: linear-gradient(135deg, #1c2333 0%, #201c33 100%);
  --quote-bg: #1b202a;
  --table-head-bg: #212839;
  background: var(--bg);
  color: var(--fg-body);
}

/* ===== 字号连续调节：正文用 --fs 变量（reader-wrap 上通过 style 注入），步进 2rpx，范围 22~38 ===== */
.rich p,
.rich .mp-list li,
.rich .mp-quote,
.rich .mp-qa-q,
.rich .mp-card p,
.rich .mp-compare-line,
.rich .mp-step-desc {
  font-size: var(--fs, 28rpx);
}
/* 标题略大于正文 */
.rich .sh { font-size: calc(var(--fs, 28rpx) + 4rpx); }
.rich h3.sh { font-size: calc(var(--fs, 28rpx) + 2rpx); }
.rich h4.sh { font-size: var(--fs, 28rpx); }
/* 行内代码相对缩小 */
.rich code { font-size: calc(var(--fs, 28rpx) * 0.86); }
/* 大字号下代码块同步微调 */
.reader-wrap[style*="--fs: 3"] .rich pre.code { font-size: 24rpx; }

/* 顶部阅读进度条 */
.read-progress { position: fixed; top: 0; left: 0; right: 0; height: 5rpx; background: transparent; z-index: 9; }
.read-progress-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #8b5cf6); border-radius: 0 999rpx 999rpx 0; transition: width 0.3s ease; }

/* ===== 阅读设置（悬浮按钮 + 弹出面板） ===== */
.reader-tools {
  position: fixed; right: 28rpx; bottom: 140rpx; z-index: 30;
  display: flex; flex-direction: column; gap: 20rpx;
}
.tool-btn {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: #ffffff; color: #4353c9;
  font-size: 30rpx; font-weight: 700; text-align: center; line-height: 84rpx;
  box-shadow: 0 6rpx 22rpx rgba(67, 83, 201, 0.22);
  border: 1rpx solid #e7ebf4;
}
.tool-btn.toc-btn { font-size: 32rpx; }
/* button 版分享按钮：清掉微信 button 默认样式，与 .tool-btn 视觉一致 */
.tool-btn.share-btn { padding: 0; font-size: 32rpx; }
.tool-btn.share-btn::after { border: none; }
.night .tool-btn.share-btn { background: #232838; color: #a5b4fc; }
.tool-btn.on { background: #4353c9; color: #ffffff; }
.night .tool-btn { background: #232838; color: #a5b4fc; border-color: #2e3547; box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.5); }
.night .tool-btn.on { background: #4353c9; color: #ffffff; }

/* ===== 章节目录抽屉（右侧滑出） ===== */
.toc-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 44;
  background: rgba(15, 23, 42, 0.38);
}
.toc-panel {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 45;
  width: 76%; max-width: 600rpx;
  background: #ffffff; box-shadow: -12rpx 0 44rpx rgba(15, 23, 42, 0.16);
  display: flex; flex-direction: column;
  animation: toc-in 0.22s ease both;
}
@keyframes toc-in { from { transform: translateX(60rpx); opacity: 0.4; } to { transform: translateX(0); opacity: 1; } }
.night .toc-panel { background: #1d212b; box-shadow: -12rpx 0 44rpx rgba(0, 0, 0, 0.55); }
.toc-head {
  flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;
  padding: 34rpx 32rpx 22rpx; border-bottom: 1rpx solid #eef1f6;
}
.night .toc-head { border-bottom-color: #2a303d; }
.toc-title { font-size: 31rpx; font-weight: 700; color: var(--fg-title); }
.toc-close {
  width: 56rpx; height: 56rpx; border-radius: 50%; text-align: center; line-height: 56rpx;
  font-size: 26rpx; color: #8a94a3; background: #f1f4f9;
}
.night .toc-close { background: #262c3a; color: #9aa5b8; }
.toc-list { flex: 1; padding: 10rpx 0 40rpx; box-sizing: border-box; }
.toc-item {
  padding: 20rpx 32rpx; font-size: 27rpx; color: var(--fg-body); line-height: 1.55;
  border-left: 6rpx solid transparent;
}
.toc-item.lv3 { padding-left: 64rpx; font-size: 25rpx; color: var(--fg-sub); }
.toc-item:active { background: #eef1fb; border-left-color: #4353c9; color: #4353c9; }
.night .toc-item:active { background: #232c4a; color: #a5b4fc; }

/* ===== 回到上次阅读位置提示 ===== */
.resume-tip {
  position: fixed; top: 120rpx; left: 50%; transform: translateX(-50%); z-index: 50;
  background: rgba(20, 26, 38, 0.88); color: #ffffff;
  font-size: 24rpx; padding: 14rpx 32rpx; border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.3);
  animation: resume-in 0.28s ease both;
}
@keyframes resume-in { from { opacity: 0; transform: translate(-50%, -16rpx); } to { opacity: 1; transform: translate(-50%, 0); } }

.settings-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 39; background: transparent; }
.settings-panel {
  position: fixed; left: 36rpx; right: 36rpx; bottom: 250rpx; z-index: 40;
  background: #ffffff; border-radius: 22rpx;
  box-shadow: 0 12rpx 44rpx rgba(15, 23, 42, 0.18);
  padding: 14rpx 30rpx;
}
.night .settings-panel { background: #1d212b; box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.55); }
.set-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 1rpx solid #eef1f6;
}
.night .set-row { border-bottom-color: #2a303d; }
.set-row:last-child { border-bottom: none; }
.set-label { font-size: 27rpx; font-weight: 600; color: inherit; }
/* 字号步进按钮 */
.fs-opts { display: flex; align-items: center; gap: 16rpx; }
.fs-step {
  width: 64rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 999rpx; font-size: 28rpx; font-weight: 700;
  background: #f1f4f9; color: #4353c9; border: 2rpx solid transparent;
}
.fs-step:active { background: #eef1ff; border-color: #4353c9; }
.fs-step.dis { opacity: 0.35; }
.night .fs-step { background: #262c3a; color: #a5b4fc; }
.night .fs-step:active { background: #2a3350; border-color: #5a7cf7; }
.fs-value {
  min-width: 72rpx; text-align: center; font-size: 28rpx; font-weight: 700;
  color: #4353c9; font-variant-numeric: tabular-nums;
}
.night .fs-value { color: #a5b4fc; }
.set-hint { font-size: 22rpx; color: #9aa3b1; padding: 12rpx 0 4rpx; }
.night .set-hint { color: #6b7588; }

/* 章节头：更像书的扉页，留白充足 */
.reader-head {
  margin: 44rpx 0 52rpx; padding: 44rpx 36rpx 40rpx;
  background: var(--head-bg);
  border-radius: 22rpx; border-left: 8rpx solid #4f6ef7;
}
.reader-chip {
  display: inline-block; font-size: 21rpx; font-weight: 600; letter-spacing: 3rpx;
  color: #7d92e8; background: rgba(255, 255, 255, 0.72); border-radius: 999rpx; padding: 6rpx 22rpx;
  box-shadow: 0 2rpx 8rpx rgba(79, 70, 229, 0.12);
}
.night .reader-chip { background: rgba(90, 124, 247, 0.16); color: #93a8f2; box-shadow: none; }
.reader-title { font-size: 42rpx; font-weight: 700; color: var(--fg-title); line-height: 1.45; margin-top: 18rpx; letter-spacing: 0.5rpx; }
.reader-sub { font-size: 25rpx; color: var(--fg-sub); margin-top: 14rpx; line-height: 1.75; }

/* 正文排版（书籍级：基准 28rpx、行距 2.05、段距充分拉开、色阶柔和） */
.rich { display: block; color: var(--fg-body); }

/* ===== rich-text 内部标签（小程序 rich-text 继承页面样式） ===== */

/* 标题层级：逐级递减 + 递缩，间距成节奏 */
.rich .ct {
  font-size: 37rpx; font-weight: 700; color: var(--fg-title);
  margin: 72rpx 0 28rpx; line-height: 1.5; letter-spacing: 0.5rpx;
}
.rich .cs { font-size: 24rpx; color: var(--fg-soft); margin: 0 0 28rpx; }
.rich .sh {
  font-size: 32rpx; font-weight: 700; color: var(--fg-title);
  margin: 68rpx 0 26rpx; padding-left: 20rpx; border-left: 7rpx solid #4f6ef7;
  line-height: 1.5; letter-spacing: 0.5rpx;
}
.rich h3.sh { font-size: 29rpx; font-weight: 600; color: var(--fg-body); border-left: 5rpx solid #b9c6f9; margin: 54rpx 0 22rpx; padding-left: 18rpx; }
.rich h4.sh { font-size: 27rpx; font-weight: 600; color: var(--fg-body); border-left: 5rpx solid #d5dcfc; margin: 46rpx 0 20rpx; padding-left: 16rpx; }
.night .rich h3.sh, .night .rich h4.sh { color: #d3dced; }
/* 长标题避免奇怪断行 */
.rich .ct, .rich .sh { word-break: break-word; }
.rich p { line-height: 2.05; margin: 26rpx 0; color: var(--fg-body); letter-spacing: 0.4rpx; text-align: justify; word-break: break-word; }
.rich strong { font-weight: 600; color: var(--fg-title); }

/* 代码块：mac 风格深色卡（三色点头部 + 语言标签 + 横滑提示 + 行尾渐隐） */
.rich .mp-codeblock {
  margin: 38rpx 0; border-radius: 18rpx;
  background: linear-gradient(180deg, #232a3b 0%, #1a2030 100%);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.18);
  border: 1rpx solid #2b3448;
}
.night .rich .mp-codeblock { background: linear-gradient(180deg, #11151f 0%, #0d1017 100%); border-color: #262c3a; }
/* 头部条：三色点 + 语言 + 横滑提示 */
.rich .mp-code-head {
  position: relative;
  background: rgba(255, 255, 255, 0.05);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  padding: 14rpx 22rpx; font-size: 20rpx;
}
.rich .mp-code-dots { display: inline-block; }
.rich .mp-code-dot {
  display: inline-block; width: 14rpx; height: 14rpx; border-radius: 50%;
  margin-right: 10rpx; vertical-align: middle;
}
.rich .mp-code-dot:nth-child(1) { background: #ff5f57; }
.rich .mp-code-dot:nth-child(2) { background: #febc2e; }
.rich .mp-code-dot:nth-child(3) { background: #28c840; }
.rich .mp-code-lang {
  font-size: 20rpx; font-weight: 700; color: #8ea2c9;
  letter-spacing: 1.5rpx; margin-left: 14rpx;
}
.rich .mp-code-hint {
  float: right; font-size: 19rpx; color: #6d7a95;
  letter-spacing: 1rpx; padding: 2rpx 0;
}
.rich pre.code {
  display: block; background: transparent; color: #d6deeb;
  padding: 26rpx 28rpx 30rpx; margin: 0; overflow-x: auto;
  font-family: "SF Mono", Menlo, Consolas, "JetBrains Mono", monospace;
  font-size: 22rpx; line-height: 1.8; white-space: pre;
  -webkit-overflow-scrolling: touch;
}
/* 行尾渐隐：提示右侧还有内容可滑动 */
.rich .mp-codeblock::after {
  content: '';
  position: absolute; top: 0; right: 0; bottom: 0; width: 56rpx;
  background: linear-gradient(90deg, rgba(26, 32, 48, 0), rgba(26, 32, 48, 0.85));
  pointer-events: none;
}
.rich .mp-codeblock { position: relative; }
/* ===== 语法高亮 token 配色（深色卡） ===== */
.rich .tok-k { color: #c792ea; font-weight: 600; }   /* 关键字：紫 */
.rich .tok-s { color: #a5d6a7; }                      /* 字符串：绿 */
.rich .tok-n { color: #f78c6c; }                      /* 数字：橙 */
.rich .tok-c { color: #7d8799; font-style: italic; }  /* 注释：灰斜体 */
.rich .tok-f { color: #82aaff; }                      /* 函数名：蓝 */
.rich .tok-t { color: #ffcb6b; }                      /* 类/类型：黄 */
/* 行内代码：与蓝紫主题呼应的浅蓝紫胶囊（小一号、垂直对齐居中） */
.rich code {
  font-family: "SF Mono", Menlo, Consolas, "JetBrains Mono", monospace;
  font-size: 0.86em; color: #4353c9; background: #eef1fb;
  padding: 2rpx 12rpx; border-radius: 8rpx;
  word-break: break-all;
}
.night .rich code { color: #a5b4fc; background: #262c3a; }
.rich pre.code code { color: inherit; background: transparent; padding: 0; border-radius: 0; font-size: inherit; }

/* 引用：留白更足 */
.rich .mp-quote {
  background: var(--quote-bg); border-left: 6rpx solid #a9b6cc; border-radius: 0 14rpx 14rpx 0;
  padding: 26rpx 28rpx; margin: 32rpx 0; font-size: 27rpx; color: var(--fg-sub); line-height: 1.95;
}
.night .rich .mp-quote { border-left-color: #4a5876; }

/* 列表：统一缩进 + 更松的行距 */
.rich .mp-list { margin: 24rpx 0; padding-left: 38rpx; }
.rich .mp-list li { line-height: 1.95; color: var(--fg-body); margin: 16rpx 0; word-break: break-word; }
.rich .mp-list li strong { color: var(--fg-title); }
/* 列表内行内代码略小 */
.rich .mp-list li code, .rich .mp-quote code { font-size: 0.82em; }

/* 表格 → 横滑 + 斑马纹 + 清晰格线
 * 注意：display:block 下 border-collapse 不生效，改用 border-spacing:0 +
 * 单元格只画右/下边框、表容器画左/上边框，拼出完整细线网格 */
.rich .mp-table {
  display: block; overflow-x: auto; white-space: nowrap;
  width: 100%; font-size: 24rpx;
  border-spacing: 0; border-collapse: collapse;
  margin: 30rpx 0; -webkit-overflow-scrolling: touch;
  border: 1rpx solid #dde3ee; border-radius: 12rpx;
  background: #ffffff;
}
.night .rich .mp-table { border-color: #2a303d; background: #171b25; }
.rich .mp-table th {
  background: var(--table-head-bg); color: #5870ae; font-weight: 600;
  padding: 18rpx 22rpx; text-align: left;
  white-space: nowrap; font-size: 24rpx;
  border-right: 1rpx solid #dde3ee; border-bottom: 2rpx solid #ccd6ea;
}
.night .rich .mp-table th { color: #93a8f2; border-right-color: #2a303d; border-bottom-color: #333c50; }
.rich .mp-table td {
  padding: 16rpx 22rpx; color: var(--fg-body);
  white-space: normal; min-width: 120rpx; line-height: 1.7;
  border-right: 1rpx solid #e6ebf4; border-bottom: 1rpx solid #e6ebf4;
}
.night .rich .mp-table td { border-right-color: #262d3b; border-bottom-color: #262d3b; }
.rich .mp-table tr { background: transparent; }

/* ===== 对话模拟气泡（chat-line 转换产物）===== */
.rich .mp-chat {
  position: relative; margin: 22rpx 0; padding: 22rpx 24rpx 22rpx 30rpx;
  background: var(--panel-bg); border: 1rpx solid var(--panel-border);
  border-radius: 6rpx 20rpx 20rpx 20rpx; line-height: 1.85;
}
.rich .mp-chat-label {
  display: inline-block; font-size: 21rpx; font-weight: 600;
  padding: 4rpx 16rpx; border-radius: 999rpx; margin: 0 0 10rpx;
  letter-spacing: 0.5rpx;
}
.rich .mp-chat-body { font-size: inherit; color: var(--fg-body); }
/* 类型色条 + 标签配色：用户蓝 / 思考紫 / 行动橙 / 观察青 / 回答绿 */
.rich .mp-chat.chat-user { border-left: 6rpx solid #4f6ef7; }
.rich .mp-chat.chat-user .mp-chat-label { color: #4353c9; background: #eef1fb; }
.rich .mp-chat.chat-thought { border-left: 6rpx solid #8b5cf6; }
.rich .mp-chat.chat-thought .mp-chat-label { color: #7c3aed; background: #f3eefe; }
.rich .mp-chat.chat-action { border-left: 6rpx solid #e8890c; }
.rich .mp-chat.chat-action .mp-chat-label { color: #c26a00; background: #fef3e2; }
.rich .mp-chat.chat-observe { border-left: 6rpx solid #0d9488; }
.rich .mp-chat.chat-observe .mp-chat-label { color: #0f766e; background: #e6f7f5; }
.rich .mp-chat.chat-reply { border-left: 6rpx solid #16a34a; }
.rich .mp-chat.chat-reply .mp-chat-label { color: #15803d; background: #eaf8ef; }
.night .rich .mp-chat { background: #141926; }
.night .rich .mp-chat.chat-user .mp-chat-label { color: #9db1f7; background: #232c4a; }
.night .rich .mp-chat.chat-thought .mp-chat-label { color: #c4a8f9; background: #2c2347; }
.night .rich .mp-chat.chat-action .mp-chat-label { color: #f0b060; background: #3d2d14; }
.night .rich .mp-chat.chat-observe .mp-chat-label { color: #5eead4; background: #10312e; }
.night .rich .mp-chat.chat-reply .mp-chat-label { color: #6ee7a0; background: #10331f; }

/* 信息卡：浅底壳 + 左侧强调条（accent 类由构建期注入，与内容色呼应） */
.rich .mp-card {
  background: var(--panel-bg); border-radius: 18rpx; padding: 30rpx 32rpx; margin: 32rpx 0;
  border: 1rpx solid var(--panel-border); border-left: 6rpx solid #d9e2ef;
}
.rich .mp-card.mp-accent-success { border-left-color: #22c55e; }
.rich .mp-card.mp-accent-warning { border-left-color: #f59e0b; }
.rich .mp-card.mp-accent-error   { border-left-color: #ef4444; }
.rich .mp-card.mp-accent-info    { border-left-color: #3b82f6; }
.rich .mp-card.mp-accent-accent  { border-left-color: #6366f1; }

/* 问答（八股总结）问句行 */
.rich .mp-qa-q {
  font-weight: 600; color: #4353c9; font-size: 27rpx;
  margin: 26rpx 0 10rpx; line-height: 1.75;
}
.night .rich .mp-qa-q { color: #93a8f2; }
/* 问答卡：答句底色微区分 */
.rich .mp-qa { background: var(--quote-bg); border: 1rpx solid var(--panel-border); }

/* 表格外壳：允许横向滚动（rich-text 内 table 无法自身滚动，用外壳撑出滑动） */
.rich .mp-table-wrap {
  margin: 30rpx 0; border-radius: 12rpx; overflow: hidden;
  border: 1rpx solid #dde3ee;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.05);
}
.night .rich .mp-table-wrap { border-color: #2a303d; }
.rich .mp-table-wrap .mp-table {
  margin: 0; border: none; border-radius: 0; box-shadow: none;
}
.rich .mp-card-title { font-size: 27rpx; font-weight: 700; color: var(--fg-title); margin-bottom: 16rpx; }
.rich .mp-card p { line-height: 1.9; margin: 14rpx 0; color: var(--fg-body); }
.rich .mp-card .mp-list { margin: 14rpx 0 8rpx; }
.rich .mp-card .mp-list li { margin: 10rpx 0; }
.rich .mp-card .mp-table { font-size: 23rpx; margin: 14rpx 0 4rpx; }
.rich .mp-card .mp-table th { padding: 12rpx 18rpx; font-size: 23rpx; }
.rich .mp-card .mp-table td { padding: 11rpx 18rpx; min-width: 100rpx; }
.rich .mp-card code { background: rgba(99, 102, 241, 0.10); color: #4353c9; }
.night .rich .mp-card code { color: #a5b4fc; background: rgba(99, 102, 241, 0.16); }

/* ===== 流程图（竖向流程卡，手机友好） ===== */
.rich .mp-flow {
  background: linear-gradient(180deg, #f8faff 0%, #f5f3ff 100%);
  border-radius: 20rpx; padding: 32rpx 28rpx; margin: 32rpx 0;
  border: 1rpx solid #e0e7ff;
}
.night .rich .mp-flow { background: #1b2030; border-color: #2a303d; }
/* 节点卡：居中圆角卡，按类型配色 */
.rich .mp-flow-card {
  border-radius: 14rpx; padding: 20rpx 26rpx; text-align: center;
  font-size: 25rpx; font-weight: 600; line-height: 1.6; margin: 0 auto; max-width: 86%;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.07);
}
.rich .mp-flow-start { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #ffffff; }
.rich .mp-flow-end { background: linear-gradient(135deg, #22c55e, #16a34a); color: #ffffff; }
.rich .mp-flow-process { background: #ffffff; color: #1e293b; border: 2rpx solid #c7d2fe; }
.night .rich .mp-flow-process { background: #262c3a; color: #dce3ef; border-color: #3a4256; }
.rich .mp-flow-tool { background: linear-gradient(135deg, #f97316, #ea580c); color: #ffffff; }
.rich .mp-flow-decision { background: linear-gradient(135deg, #f59e0b, #d97706); color: #ffffff; }
.rich .mp-flow-memory { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #ffffff; }
.rich .mp-flow-condition { background: linear-gradient(135deg, #f59e0b, #d97706); color: #ffffff; }
.rich .mp-flow-loop { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #ffffff; }
.rich .mp-flow-branch { opacity: 0.85; }

/* 连接箭头 */
.rich .mp-flow-link {
  display: flex; flex-direction: column; align-items: center; padding: 8rpx 0;
}
.rich .mp-flow-link-label {
  font-size: 20rpx; color: #5a6cd8; background: #eef1ff;
  border-radius: 999rpx; padding: 4rpx 20rpx; margin-bottom: 4rpx; font-weight: 600;
}
.night .rich .mp-flow-link-label { color: #93a8f2; background: #262f4a; }
.rich .mp-flow-link-arrow { color: #97a5ef; font-size: 26rpx; line-height: 1.2; font-weight: 700; }

/* 占位提示 */
.rich .mp-note { background: #fffbeb; color: #92400e; border-radius: 12rpx; padding: 22rpx 26rpx; font-size: 25rpx; line-height: 1.75; }
.night .rich .mp-note { background: #2b2416; color: #d9b47a; }

/* ===== 对比卡（左右双栏） ===== */
.rich .mp-compare { display: flex; gap: 16rpx; margin: 32rpx 0; }
.rich .mp-compare-side { flex: 1; border-radius: 14rpx; padding: 22rpx 22rpx; }
.rich .mp-compare-side:first-child { background: #f0f7ff; border: 1rpx solid #cfe3fb; }
.rich .mp-compare-side:last-child { background: #fef4f4; border: 1rpx solid #f8d7d7; }
.night .rich .mp-compare-side:first-child { background: #1a2436; border-color: #2a3850; }
.night .rich .mp-compare-side:last-child { background: #2b1d20; border-color: #45282c; }
.rich .mp-compare-label { font-size: 25rpx; font-weight: 700; margin-bottom: 12rpx; text-align: center; }
.rich .mp-compare-side:first-child .mp-compare-label { color: #1d4ed8; }
.rich .mp-compare-side:last-child .mp-compare-label { color: #b91c1c; }
.night .rich .mp-compare-side:first-child .mp-compare-label { color: #7fa8f5; }
.night .rich .mp-compare-side:last-child .mp-compare-label { color: #f08a8a; }
.rich .mp-compare-line { font-size: 24rpx; line-height: 1.85; color: var(--fg-body); margin: 8rpx 0; }

/* ===== 步骤列表 ===== */
.rich .mp-steps { margin: 30rpx 0; }
.rich .mp-step { display: flex; margin-bottom: 24rpx; }
.rich .mp-step-num {
  width: 48rpx; height: 48rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff;
  text-align: center; line-height: 48rpx; font-size: 22rpx; font-weight: 700;
  margin-right: 18rpx; margin-top: 3rpx;
}
.rich .mp-step-body { flex: 1; }
.rich .mp-step-title { font-size: 27rpx; font-weight: 600; color: var(--fg-title); line-height: 1.6; }
.rich .mp-step-desc { font-size: 25rpx; color: var(--fg-sub); line-height: 1.85; margin-top: 8rpx; }

/* 章末闯关入口 */
.quiz-cta {
  display: flex; align-items: center; margin-top: 72rpx;
  background: linear-gradient(135deg, #1e1b4b, #6d28d9);
  border-radius: 20rpx; padding: 30rpx 32rpx; color: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(76, 29, 149, 0.28);
}
.cta-left { flex: 1; overflow: hidden; }
.cta-title { font-size: 28rpx; font-weight: 700; }
.cta-sub { font-size: 22rpx; opacity: 0.75; margin-top: 6rpx; }
.cta-btn {
  flex-shrink: 0; background: #fde047; color: #4c1d95;
  font-size: 25rpx; font-weight: 700; padding: 14rpx 32rpx; border-radius: 999rpx;
}

.reader-end { text-align: center; color: #8b95a6; font-size: 23rpx; margin: 60rpx 0 28rpx; letter-spacing: 1rpx; }
.night .reader-end { color: #5c6577; }

/* 底部导航 */
.reader-nav { display: flex; gap: 20rpx; }
.nav-btn { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; }
.nav-btn.prev { background: var(--panel-bg); color: var(--fg-body); border: 2rpx solid var(--panel-border); }
.nav-btn.next { background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff; box-shadow: 0 5rpx 18rpx rgba(67, 83, 201, 0.28); }
.nav-progress { text-align: center; font-size: 23rpx; color: #9aa3b1; margin-top: 18rpx; }
.night .nav-progress { color: #6b7588; }

/* ===== 收藏/笔记弹窗 ===== */
.fav-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 200;
}
.fav-modal {
  position: fixed; left: 50%; top: 45%; transform: translate(-50%, -50%);
  width: 620rpx; max-width: 88vw; background: var(--panel-bg, #fff);
  border-radius: 24rpx; padding: 32rpx; z-index: 201;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.25);
}
.fav-quote {
  font-size: 24rpx; color: #8b95a6; line-height: 1.6;
  border-left: 6rpx solid #eab308; padding-left: 16rpx; margin-bottom: 20rpx;
  word-break: break-all;
}
.night .fav-quote { color: #9aa3b1; }
.fav-input {
  width: 100%; min-height: 140rpx; box-sizing: border-box;
  border: 2rpx solid var(--panel-border, #e5e7eb); border-radius: 14rpx;
  padding: 18rpx; font-size: 26rpx; color: var(--fg-body, #1f2937);
  background: var(--panel-bg, #fff);
}
.fav-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 22rpx; }
.fav-act {
  padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx;
  border: 2rpx solid var(--panel-border, #e5e7eb); color: var(--fg-body, #374151);
}
.fav-act.primary {
  background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #fff; border: none;
}
.fav-btn { font-size: 34rpx; }

/* ===== 语音朗读 ===== */
.tool-btn.tts-btn { font-size: 30rpx; }
.tts-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 46;
  background: rgba(15, 23, 42, 0.38);
}
.tts-panel {
  position: fixed; left: 36rpx; right: 36rpx; bottom: 250rpx; z-index: 47;
  background: #ffffff; border-radius: 22rpx;
  box-shadow: 0 12rpx 44rpx rgba(15, 23, 42, 0.22);
  padding: 24rpx 30rpx 20rpx;
  animation: toc-in 0.22s ease both;
}
.night .tts-panel { background: #1d212b; box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.55); }
.tts-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 18rpx; border-bottom: 1rpx solid #eef1f6;
  margin-bottom: 18rpx;
}
.night .tts-head { border-bottom-color: #2a303d; }
.tts-title { font-size: 30rpx; font-weight: 700; color: var(--fg-title); }
.tts-close {
  width: 52rpx; height: 52rpx; border-radius: 50%; text-align: center; line-height: 52rpx;
  font-size: 24rpx; color: #8a94a3; background: #f1f4f9;
}
.night .tts-close { background: #262c3a; color: #9aa5b8; }

.tts-row { margin-bottom: 20rpx; }
.tts-label { font-size: 25rpx; font-weight: 600; color: var(--fg-body); margin-bottom: 12rpx; }
.tts-voices { display: flex; gap: 14rpx; }
.voice-opt {
  flex: 1; text-align: center; padding: 14rpx 8rpx;
  background: #f1f4f9; border: 2rpx solid transparent; border-radius: 14rpx;
  font-size: 24rpx; color: #5b6675;
}
.voice-opt.on { background: #eef1ff; border-color: #4353c9; color: #4353c9; }
.night .voice-opt { background: #262c3a; color: #9aa5b8; }
.night .voice-opt.on { background: #2a3350; border-color: #5a7cf7; color: #a5b4fc; }
.voice-name { font-weight: 700; font-size: 25rpx; }
.voice-desc { font-size: 20rpx; opacity: 0.75; margin-top: 4rpx; }

.tts-rate-val {
  min-width: 64rpx; text-align: center; font-size: 26rpx; font-weight: 700;
  color: #4353c9; font-variant-numeric: tabular-nums;
}
.night .tts-rate-val { color: #a5b4fc; }

.tts-controls { display: flex; gap: 14rpx; margin: 20rpx 0 14rpx; }
.tts-ctl-btn {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 999rpx;
  font-size: 26rpx; font-weight: 600;
  background: #f1f4f9; color: #4353c9; border: 2rpx solid transparent;
}
.tts-ctl-btn.primary {
  background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(67, 83, 201, 0.3);
}
.tts-ctl-btn.stop { background: #fee2e2; color: #dc2626; }
.night .tts-ctl-btn { background: #262c3a; color: #a5b4fc; }
.night .tts-ctl-btn.primary { background: linear-gradient(135deg, #5a7cf7, #4353c9); color: #ffffff; }
.night .tts-ctl-btn.stop { background: #3a2121; color: #f87171; }

.tts-status { font-size: 23rpx; color: #8a94a3; text-align: center; padding: 4rpx 0 8rpx; }
.tts-hint { font-size: 21rpx; color: #9aa3b1; line-height: 1.6; padding-top: 10rpx; border-top: 1rpx dashed #eef1f6; }
.night .tts-hint { color: #6b7588; border-top-color: #2a303d; }
.tts-unsupported { font-size: 25rpx; color: #9aa3b1; text-align: center; padding: 30rpx 10rpx; line-height: 1.8; }
