.wrap { padding: 24rpx 24rpx 60rpx; background: #f6f4ef; min-height: 100vh; box-sizing: border-box; }

/* ===== Hero（纸面编辑部风格）===== */
.hero {
  position: relative; overflow: hidden;
  background: #fffefb; border: 1rpx solid #e0dbcf;
  border-radius: 20rpx; padding: 40rpx 34rpx; margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(50, 42, 30, 0.05);
}
.hero-deco { position: absolute; border-radius: 50%; background: #f6ede3; }
.hero-deco.d1 { width: 240rpx; height: 240rpx; right: -70rpx; top: -80rpx; opacity: 0.7; }
.hero-deco.d2 { width: 140rpx; height: 140rpx; right: 80rpx; bottom: -50rpx; opacity: 0.45; }
.hero-badge {
  display: inline-block; font-size: 20rpx; letter-spacing: 3rpx; font-weight: 600;
  color: #9a4a1e; background: #f6ede3; border: 1rpx solid #ddc4ab;
  border-radius: 999rpx; padding: 6rpx 18rpx; margin-bottom: 16rpx;
  position: relative;
}
.hero-title {
  font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; color: #1f1b16;
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  position: relative;
}
.hero-sub { font-size: 24rpx; color: #837a6d; margin-top: 10rpx; position: relative; }
.hero-meta {
  display: flex; align-items: center; gap: 10rpx; margin-top: 24rpx;
  font-size: 22rpx; color: #3d6b4f;
  background: #edf3ec; border: 1rpx solid #cfe0cf;
  border-radius: 12rpx; padding: 12rpx 18rpx; width: fit-content;
  position: relative;
}
.hero-meta.off { color: #a03028; background: #f8ece8; border-color: #e4c4bd; }
.meta-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3d6b4f; }
.meta-dot.off { background: #a03028; }
.offline-hint {
  position: relative;
  margin-top: 16rpx; font-size: 22rpx; color: #a03028; line-height: 1.7;
  background: #f8ece8; border-radius: 12rpx; padding: 14rpx 20rpx;
}

/* ===== 分组（侧栏质感）===== */
.group {
  background: #fffefb; border: 1rpx solid #e0dbcf;
  border-radius: 18rpx; margin-bottom: 20rpx;
  overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(50, 42, 30, 0.04);
}
.group-head {
  display: flex; align-items: center; padding: 24rpx 28rpx;
  background: #efece4;
}
.group-name {
  font-size: 28rpx; font-weight: 700; color: #1f1b16;
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
}
.group-count { margin-left: auto; font-size: 22rpx; color: #837a6d; margin-right: 12rpx; }
.group-arrow { font-size: 30rpx; color: #b8b0a0; transition: transform 0.2s; transform: rotate(90deg); }
.group-arrow.open { transform: rotate(270deg); }

.scene-list { padding: 0 16rpx 12rpx; }
.scene-item {
  display: flex; align-items: center; padding: 22rpx 14rpx;
  border-top: 1rpx solid #e9e5da;
}
.scene-num {
  width: 64rpx; height: 64rpx; border-radius: 14rpx; flex-shrink: 0;
  background: #f6ede3; color: #9a4a1e; border: 1rpx solid #ddc4ab;
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 22rpx;
}
.scene-info { flex: 1; min-width: 0; }
.scene-title { font-size: 29rpx; font-weight: 600; color: #1f1b16; display: flex; align-items: center; gap: 12rpx; }
.scene-tag {
  font-size: 18rpx; font-weight: 500; color: #8a6116;
  background: #f7f0de; border: 1rpx solid #e6d6ab;
  border-radius: 8rpx; padding: 2rpx 10rpx;
}
.scene-sub { font-size: 23rpx; color: #837a6d; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scene-arrow { font-size: 32rpx; color: #c4bca9; margin-left: 12rpx; }

.footnote { font-size: 22rpx; color: #837a6d; line-height: 1.7; padding: 8rpx 12rpx 0; }
