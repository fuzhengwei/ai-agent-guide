.page { min-height: 100vh; background: #f6f7f9; padding-bottom: 60rpx; }
.press { opacity: 0.75; transform: scale(0.98); }

/* ---------- Hero ---------- */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%);
  padding: 70rpx 40rpx 86rpx;
  color: #fff;
}
.hero-deco {
  position: absolute; border-radius: 50%;
  background: radial-gradient(circle, rgba(99,102,241,.22), transparent 70%);
}
.hero-deco.d1 { width: 380rpx; height: 380rpx; top: -140rpx; right: -100rpx; }
.hero-deco.d2 { width: 260rpx; height: 260rpx; bottom: -100rpx; left: -80rpx; background: radial-gradient(circle, rgba(37,99,235,.25), transparent 70%); }
.hero-badge {
  position: relative;
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #a5b4fc;
  background: rgba(99, 102, 241, 0.15);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.hero-title { position: relative; font-size: 52rpx; font-weight: 900; letter-spacing: 2rpx; }
.hero-sub {
  position: relative;
  font-size: 25rpx; color: #b6c2d4; margin-top: 18rpx; line-height: 1.7;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
}

/* ---------- 加入星球（作者卡上方） ---------- */
.join-wrap { margin: -62rpx 24rpx 0; position: relative; z-index: 2; }
.go-card {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 1rpx solid #bfdbfe;
  border-radius: 22rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, 0.14);
}
.go-left { display: flex; align-items: center; min-width: 0; }
.go-emoji { font-size: 50rpx; margin-right: 20rpx; }
.go-info { min-width: 0; }
.go-title { font-size: 31rpx; font-weight: 800; color: #1e40af; }
.go-sub { font-size: 22rpx; color: #3b82f6; margin-top: 6rpx; }
.go-btn {
  font-size: 26rpx; font-weight: 700; color: #fff; flex-shrink: 0;
  background: linear-gradient(135deg, #5a7cf7, #4353c9);
  padding: 14rpx 28rpx; border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.28);
}
.ios-tip {
  margin-top: 14rpx; text-align: center;
  font-size: 21rpx; color: #b45309;
  background: #fffbeb; border: 1rpx solid #fde68a;
  border-radius: 12rpx; padding: 10rpx 16rpx; line-height: 1.6;
}

/* ---------- 作者卡 ---------- */
.author-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}
.author-avatar {
  width: 92rpx; height: 92rpx; border-radius: 50%;
  background: linear-gradient(135deg, #5a7cf7, #4353c9);
  color: #fff; font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 22rpx;
}
.author-info { flex: 1; min-width: 0; }
.author-name { font-size: 32rpx; font-weight: 800; color: #0f172a; }
.author-tag {
  font-size: 20rpx; font-weight: 600; color: #4353c9;
  background: rgba(90, 124, 247, 0.1);
  border: 1rpx solid rgba(90, 124, 247, 0.25);
  border-radius: 999rpx; padding: 4rpx 14rpx; margin-left: 12rpx;
  vertical-align: 4rpx;
}
.author-desc { font-size: 23rpx; color: #64748b; margin-top: 10rpx; line-height: 1.7; }

/* ---------- 星球服务 ---------- */
.sec { padding: 20rpx 24rpx 0; }
.sec-title { font-size: 30rpx; font-weight: 900; color: #0f172a; margin-bottom: 20rpx; padding: 0 8rpx; }
.sec-sub { font-size: 22rpx; font-weight: 500; color: #94a3b8; margin-left: 10rpx; }
.serve-grid {
  background: #fff; border-radius: 20rpx; padding: 24rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
  display: flex; flex-wrap: wrap;
}
.serve-cell {
  width: 33.33%; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 16rpx 0; font-size: 24rpx; color: #374151; font-weight: 600;
}
.serve-emoji { font-size: 40rpx; }
.serve-note {
  font-size: 22rpx; color: #8a94a6; line-height: 1.7;
  margin: 16rpx 8rpx 0;
}

/* ---------- 项目学习 ---------- */
.proj-feat { display: flex; flex-direction: column; gap: 16rpx; }
.pf-card {
  background: #fff; border-radius: 18rpx; padding: 24rpx;
  border: 1rpx solid #eef1f6;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.03);
}
.pf-card.hot { border: 2rpx solid rgba(90, 124, 247, 0.4); background: linear-gradient(180deg, #f6f8ff, #fff); }
.pf-name { font-size: 27rpx; font-weight: 800; color: #0f172a; }
.pf-flag {
  font-size: 19rpx; font-weight: 700; color: #fff;
  background: linear-gradient(135deg, #5a7cf7, #4353c9);
  border-radius: 999rpx; padding: 3rpx 14rpx; margin-left: 10rpx;
  vertical-align: 3rpx;
}
.pf-desc { font-size: 23rpx; color: #64748b; line-height: 1.7; margin-top: 10rpx; }
.preview-tip {
  margin-top: 18rpx;
  background: #fff; border: 1rpx dashed #c9d4f5; border-radius: 16rpx;
  padding: 20rpx 24rpx; font-size: 24rpx; color: #4353c9; font-weight: 600;
  text-align: center;
}

/* ---------- 就业指导 / 通用列表 ---------- */
.gain-list {
  background: #fff; border-radius: 20rpx; padding: 10rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}
.gain-row {
  display: flex; align-items: flex-start;
  font-size: 26rpx; color: #374151; line-height: 1.7;
  padding: 18rpx 0;
}
.gain-row + .gain-row { border-top: 1rpx solid #f1f3f7; }
.gain-dot { color: #5a7cf7; font-weight: 700; margin-right: 14rpx; }

/* ---------- 底部引导 ---------- */
.bottom-cta {
  margin: 44rpx 24rpx 0; text-align: center;
  font-size: 27rpx; font-weight: 800; color: #fff;
  background: linear-gradient(135deg, #5a7cf7, #4353c9);
  border-radius: 999rpx; padding: 26rpx;
  box-shadow: 0 10rpx 26rpx rgba(37, 99, 235, 0.3);
}

.tail {
  text-align: center; font-size: 22rpx; color: #b0b7c3;
  margin-top: 40rpx; letter-spacing: 1rpx;
}
