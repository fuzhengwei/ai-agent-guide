<view class="wrap">
  <!-- 个人资料卡 -->
  <view class="profile-card">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="avatar avatar-fb" wx:else style="background:rgba(255,255,255,.18)">{{initial}}</view>
      <view class="avatar-edit">✏️</view>
    </button>
    <view class="profile-info">
      <input
        class="nickname-input"
        type="nickname"
        value="{{nickname}}"
        placeholder="点我设置昵称"
        placeholder-class="nickname-ph"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        bindconfirm="onNicknameBlur"
        confirm-type="done"
      />
      <view class="profile-sub">
        <text>⏱ {{studyTimeText}}</text>
        <text wx:if="{{studyDays > 0}}"> · 连续 {{studyDays}} 天</text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats">
    <view class="stat-card">
      <view class="stat-num">{{readCount}}<text class="stat-max">/{{total}}</text></view>
      <view class="stat-label">已读章节</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{xp}}</view>
      <view class="stat-label">总积分</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">⭐{{stars}}<text class="stat-max">/{{totalStars}}</text></view>
      <view class="stat-label">累计星数</view>
    </view>
  </view>

  <!-- 学习入口 -->
  <view class="menu">
    <view class="menu-item" bindtap="goNotes">
      <view class="menu-title"><text class="menu-icon icon-amber">⭐</text>我的收藏与笔记</view>
      <view class="arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goLeaderboard">
      <view class="menu-title"><text class="menu-icon icon-gold">🏆</text>排行榜</view>
      <view class="arrow">›</view>
    </view>
    <view class="menu-item" bindtap="makePoster">
      <view class="menu-title"><text class="menu-icon icon-pink">🎨</text>分享我的学习海报</view>
      <view class="arrow">›</view>
    </view>
  </view>

  <!-- 解锁（付费开关开启时） -->
  <view class="menu" wx:if="{{payEnabled}}">
    <view class="menu-item" bindtap="toggleUnlock">
      <view class="menu-title"><text class="menu-icon icon-violet">🔓</text>{{unlocked ? '已解锁全部章节 ✓' : '解锁全部章节'}}</view>
      <view class="arrow">›</view>
    </view>
  </view>

  <!-- 通用 -->
  <view class="menu">
    <button class="menu-item share-item" open-type="share">
      <view class="menu-title"><text class="menu-icon icon-blue">📤</text>推荐给朋友</view>
      <view class="arrow">›</view>
    </button>
    <view class="menu-item" bindtap="about">
      <view class="menu-title"><text class="menu-icon icon-teal">ℹ️</text>关于本教程</view>
      <view class="arrow">›</view>
    </view>
    <view class="menu-item danger" bindtap="clearData">
      <view class="menu-title"><text class="menu-icon icon-red">🗑</text>清除学习记录</view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="footer">AI Agent 通识教程 v2.0.1</view>

  <!-- 离屏 Canvas 用于生成海报 -->
  <canvas type="2d" id="posterCanvas" style="position:fixed;left:-9999px;top:-9999px;width:375px;height:700px;" />
</view>
