/* 勇者冒险岛 · 地图页 */
page {
  height: 100%;
  overflow: hidden;
}

.map-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---------- 顶部状态条 ---------- */
.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  background: rgba(255, 255, 255, 0.55);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.6);
  z-index: 10;
}
.topbar-left { display: flex; flex-direction: column; }
.topbar-title { font-size: 32rpx; font-weight: 900; color: #2e3a52; }
.topbar-sub { font-size: 20rpx; color: #7a8aa0; margin-top: 2rpx; }
.topbar-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(90, 120, 170, 0.2);
}
.btn-press { transform: scale(0.88); }

/* ---------- 地图长卷 ---------- */
.map-scroll { flex: 1; }
.map-canvas { position: relative; width: 100%; }
.map-tail { height: 160rpx; }

/* 区域色带：7 段从下到上由暖到冷 */
.band {
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
}
.band:nth-child(1) { background: linear-gradient(180deg, rgba(207,226,255,0.5), rgba(240,246,255,0.35)); }
.band:nth-child(2) { background: linear-gradient(180deg, rgba(159,200,255,0.35), rgba(220,234,255,0.22)); }
.band:nth-child(3) { background: linear-gradient(180deg, rgba(255,196,214,0.28), rgba(255,233,240,0.18)); }
.band:nth-child(4) { background: linear-gradient(180deg, rgba(201,184,255,0.26), rgba(236,229,255,0.16)); }
.band:nth-child(5) { background: linear-gradient(180deg, rgba(174,232,255,0.3), rgba(224,245,255,0.18)); }
.band:nth-child(6) { background: linear-gradient(180deg, rgba(255,217,168,0.32), rgba(255,239,214,0.2)); }
.band:nth-child(7) { background: linear-gradient(180deg, rgba(168,230,255,0.4), rgba(227,248,255,0.25)); }

/* ---------- 云朵 ---------- */
.cloud {
  position: absolute;
  opacity: 0.85;
  animation: drift 7s ease-in-out infinite;
  pointer-events: none;
}
.cloud.c1 { animation-duration: 9s; animation-delay: 1.2s; }
.cloud.c2 { animation-duration: 11s; animation-delay: 2.4s; }
@keyframes drift {
  0%, 100% { margin-left: 0; }
  50% { margin-left: 24rpx; }
}

/* ---------- 山路 ---------- */
.map-path {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ---------- 路边装饰 ---------- */
.decor {
  position: absolute;
  transform: translate(-50%, -50%);
  filter: drop-shadow(0 3rpx 3rpx rgba(60, 80, 40, 0.18));
  pointer-events: none;
}

/* ---------- 王冠 ---------- */
.crown {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 68rpx;
  opacity: 0.35;
  filter: grayscale(1);
}
.crown.lit {
  opacity: 1;
  filter: none;
  animation: crownGlow 1.6s ease-in-out infinite;
}
@keyframes crownGlow {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -56%) scale(1.12); }
}

/* ---------- 宝箱 ---------- */
.chest {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 48rpx;
  opacity: 0.55;
  filter: grayscale(0.6);
}
.chest.opened {
  opacity: 1;
  filter: none;
  animation: chestBounce 1.8s ease-in-out infinite;
}
@keyframes chestBounce {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -58%) scale(1.1); }
}

/* ---------- 关卡节点 ---------- */
.node {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}
.node-press { transform: translate(-50%, -50%) scale(0.9); }

.node-bubble {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 5rpx solid #d5e0ec;
  box-shadow: 0 6rpx 0 rgba(160, 180, 205, 0.6), 0 10rpx 20rpx rgba(90, 120, 170, 0.18);
}
.node-lock { font-size: 34rpx; opacity: 0.7; }
.node-num { font-size: 32rpx; font-weight: 900; color: #fff; }
.node-star { font-size: 36rpx; }

/* 当前关：橙色活力 */
.node.current .node-bubble {
  background: linear-gradient(160deg, #ffb347, #ff8c42);
  border-color: #fff;
  box-shadow: 0 6rpx 0 #d96a1a, 0 12rpx 26rpx rgba(255, 140, 66, 0.5);
  animation: nodeBob 1.6s ease-in-out infinite;
}
@keyframes nodeBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 已通关：绿色+金边 */
.node.cleared .node-bubble {
  background: linear-gradient(160deg, #7dd069, #4cb944);
  border-color: #ffe49a;
  box-shadow: 0 6rpx 0 #359835, 0 10rpx 20rpx rgba(76, 185, 68, 0.35);
}

/* 未解锁：灰白 */
.node.locked .node-bubble {
  background: #eef2f7;
  border-color: #dde5ee;
  box-shadow: 0 5rpx 0 rgba(180, 195, 215, 0.5);
}

.node-flag {
  position: absolute;
  top: -52rpx;
  right: -34rpx;
  font-size: 36rpx;
  filter: drop-shadow(0 2rpx 2rpx rgba(0,0,0,0.15));
  animation: flagWave 2.2s ease-in-out infinite;
}
.node.locked .node-flag { opacity: 0.4; filter: grayscale(1); animation: none; }
@keyframes flagWave {
  0%, 100% { transform: rotate(-6deg); }
  50% { transform: rotate(8deg); }
}

.node-name {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #4a5a75;
  background: rgba(255, 255, 255, 0.88);
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  box-shadow: 0 3rpx 8rpx rgba(90, 120, 170, 0.15);
  white-space: nowrap;
}
.node-name.locked { color: #a5b2c4; }
.node-name.current { color: #e07020; }

/* 当前关的扩散光圈 */
.node-pulse {
  position: absolute;
  top: 42rpx;
  left: 50%;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 140, 66, 0.55);
  transform: translate(-50%, -50%);
  animation: pulse 1.6s ease-out infinite;
  pointer-events: none;
}
@keyframes pulse {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 0.9; }
  100% { transform: translate(-50%, -50%) scale(2.1); opacity: 0; }
}

/* ---------- 小狐狸 ---------- */
.fox {
  position: absolute;
  transform: translate(-50%, -96%);
  font-size: 54rpx;
  z-index: 4;
  filter: drop-shadow(0 4rpx 4rpx rgba(60, 60, 20, 0.25));
  transition: left 0.8s cubic-bezier(0.34, 1.3, 0.64, 1), top 0.8s cubic-bezier(0.34, 1.3, 0.64, 1);
  animation: foxBob 1.1s ease-in-out infinite;
  pointer-events: none;
}
@keyframes foxBob {
  0%, 100% { margin-top: 0; }
  50% { margin-top: -10rpx; }
}

/* ---------- 全通关横幅 ---------- */
.allclear {
  position: fixed;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  background: linear-gradient(90deg, #fff3c9, #ffe49a);
  color: #8a6a10;
  font-size: 25rpx;
  font-weight: 800;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 30rpx rgba(200, 160, 40, 0.35);
  animation: bannerIn 0.6s cubic-bezier(0.34, 1.5, 0.64, 1);
  z-index: 20;
  white-space: nowrap;
}
@keyframes bannerIn {
  from { opacity: 0; transform: translateX(-50%) translateY(60rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ---------- 关卡弹窗 ---------- */
.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(40, 52, 80, 0.48);
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.popup-card {
  width: 100%;
  background: #fff;
  border-radius: 44rpx 44rpx 0 0;
  overflow: hidden;
  box-shadow: 0 -16rpx 60rpx rgba(30, 40, 70, 0.3);
  animation: sheetIn 0.4s cubic-bezier(0.34, 1.3, 0.64, 1);
  padding-bottom: env(safe-area-inset-bottom);
}
@keyframes sheetIn {
  from { transform: translateY(60%); opacity: 0.4; }
  to { transform: none; opacity: 1; }
}

.popup-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 36rpx 36rpx 30rpx;
}
.popup-icon {
  font-size: 64rpx;
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08);
}
.popup-head-text { display: flex; flex-direction: column; gap: 6rpx; }
.popup-name { font-size: 36rpx; font-weight: 900; color: #fff; text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.18); }
.popup-monster { font-size: 23rpx; color: rgba(255, 255, 255, 0.92); }

.popup-body { padding: 28rpx 36rpx 40rpx; }

.popup-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.meta-chip {
  font-size: 22rpx;
  font-weight: 700;
  color: #5a6b85;
  background: #f1f5fa;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.meta-chip.gold { color: #b8860b; background: #fff3c9; }

.popup-tip {
  background: #f7fafd;
  border: 2rpx dashed #c9d8ea;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
}
.popup-tip-label { font-size: 22rpx; font-weight: 800; color: #5ea8f5; margin-bottom: 10rpx; }
.popup-tip-q { font-size: 26rpx; font-weight: 700; color: #2e3a52; line-height: 1.5; margin-bottom: 8rpx; }
.popup-tip-a { font-size: 24rpx; color: #6b7d99; line-height: 1.5; }

.popup-btns { display: flex; gap: 22rpx; }
.popup-btns .btn { flex: 1; }

/* ---------- 按钮（与答题页一致的卡通按钮） ---------- */
.btn {
  border: none;
  border-radius: 999rpx;
  font-weight: 800;
  font-size: 30rpx;
  line-height: 2.6;
  padding: 0 40rpx;
  margin: 0;
}
.btn::after { border: none; }
.btn.primary {
  background: linear-gradient(135deg, #ffb347, #ff8c42);
  color: #fff;
  box-shadow: 0 8rpx 0 #e07020, 0 14rpx 24rpx rgba(255, 140, 66, 0.35);
}
.btn.ghost {
  background: #f1f5fa;
  color: #5a6b85;
  box-shadow: 0 6rpx 0 #d5e0ec;
}
.btn-hover { transform: translateY(4rpx) scale(0.98); filter: brightness(0.96); }
