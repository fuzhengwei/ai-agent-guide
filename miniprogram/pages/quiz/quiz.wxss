/* 面试 tab 首页 · 教程配套面试 */
page {
  background: #f4f5f7;
  height: 100%;
  overflow-y: auto;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.press { opacity: 0.7; transform: scale(0.98); }

/* ---------- 语音讲解入口 ---------- */
.listen-entry {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 1rpx solid #bfdbfe;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.listen-left { display: flex; align-items: center; min-width: 0; }
.listen-emoji { font-size: 48rpx; margin-right: 20rpx; }
.listen-title { font-size: 30rpx; font-weight: 700; color: #1e40af; }
.listen-sub { font-size: 22rpx; color: #3b82f6; margin-top: 4rpx; }
.listen-go {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
  flex-shrink: 0;
}

/* ---------- 项目推荐（外部小程序跳转） ---------- */
.proj-card {
  margin-top: 20rpx;
  background: #fff;
  border: 1rpx solid #e6e9f0;
  border-radius: 20rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}
.proj-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.proj-info { flex: 1; min-width: 0; }
.proj-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #0f172a;
}
.proj-desc {
  font-size: 22rpx;
  color: #8a94a6;
  margin-top: 6rpx;
  line-height: 1.5;
}
.proj-go {
  font-size: 30rpx;
  color: #c2c9d6;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 12rpx;
}
/* 项目卡副文案较长，允许两行 */
.proj-info .proj-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* ---------- Hero ---------- */
.hero {
  background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%);
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
}
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #a5b4fc;
  background: rgba(99, 102, 241, 0.15);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}
.hero-stats {
  display: flex;
  gap: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.stat { display: flex; flex-direction: column; gap: 4rpx; }
.stat-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #fff;
}
.stat-key {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 1rpx;
}

/* ---------- Section ---------- */
.sec {
  padding: 40rpx 32rpx 0;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}
.sec-sub {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-left: 12rpx;
}

/* ---------- 面试官风格：横排芯片 ---------- */
.style-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}
.style-row {
  display: inline-flex;
  gap: 16rpx;
}
.style-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  flex-shrink: 0;
}
.style-chip.on {
  background: linear-gradient(160deg, #eef2ff, #e0e7ff);
  border-color: #6366f1;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.15);
}
.style-emoji { font-size: 32rpx; }
.style-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}
.style-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ---------- 大厂真题 ---------- */
.boss-grid {
  display: flex;
  gap: 16rpx;
}
.boss-card {
  flex: 1;
  min-width: 0;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 28rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.boss-emoji { font-size: 40rpx; margin-bottom: 12rpx; }
.boss-name {
  font-size: 26rpx;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.boss-meta {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 600;
}

/* ---------- 混合面试 ---------- */
.mix-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.mix-row {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.mix-row.hot {
  background: linear-gradient(160deg, #fef3c7, #fde68a);
  border-color: #fbbf24;
}
.mix-emoji { font-size: 40rpx; }
.mix-info {
  flex: 1;
  min-width: 0;
}
.mix-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mix-hot {
  font-size: 18rpx;
  font-weight: 900;
  color: #fff;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}
.mix-desc {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.mix-go {
  font-size: 36rpx;
  color: #cbd5e1;
  font-weight: 300;
}
.mix-row.hot .mix-go { color: #f59e0b; }

/* ---------- 章节面试 ---------- */
.ch-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ch-row {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ch-num {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(160deg, #f1f5f9, #e2e8f0);
  color: #475569;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ch-info {
  flex: 1;
  min-width: 0;  /* 关键：允许 flex 子项收缩到内容以下 */
}
.ch-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ch-sub {
  font-size: 21rpx;
  color: #94a3b8;
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ch-right { flex-shrink: 0; }
.ch-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  letter-spacing: 0.5rpx;
}
.ch-badge.pass {
  color: #059669;
  background: #d1fae5;
}
.ch-badge.doing {
  color: #d97706;
  background: #fef3c7;
}

.tail { height: 60rpx; }
