/* 面试间首页 · 精致现代风 */
page {
  background: #f4f5f7;
  height: 100%;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.press { opacity: 0.7; transform: scale(0.98); }

/* ---------- Hero ---------- */
.hero {
  background: linear-gradient(160deg, #1e293b 0%, #0f172a 100%);
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  color: #a5b4fc;
  background: rgba(99, 102, 241, 0.15);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.hero-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-bottom: 40rpx;
  letter-spacing: 1rpx;
}
.hero-stats {
  display: flex;
  gap: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.stat { display: flex; flex-direction: column; gap: 4rpx; }
.stat-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #fff;
}
.stat-key {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 1rpx;
}

/* ---------- Section ---------- */
.sec {
  padding: 40rpx 32rpx 0;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}
.sec-sub {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-left: 12rpx;
}

/* ---------- 风格选择 ---------- */
.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.style-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  position: relative;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.style-card.on {
  background: linear-gradient(160deg, #eef2ff, #e0e7ff);
  border-color: #6366f1;
  box-shadow: 0 8rpx 20rpx rgba(99, 102, 241, 0.15);
}
.style-emoji { font-size: 44rpx; margin-bottom: 12rpx; }
.style-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 6rpx;
}
.style-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}
.style-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #6366f1;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.style-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  letter-spacing: 0.5rpx;
}
.style-tip .hl {
  color: #6366f1;
  font-weight: 800;
}

/* ---------- 大厂真题 ---------- */
.boss-row {
  display: flex;
  gap: 16rpx;
}
.boss-card {
  flex: 1;
  background: linear-gradient(160deg, #fff, #fafafa);
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 28rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.boss-emoji { font-size: 40rpx; margin-bottom: 14rpx; }
.boss-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 6rpx;
}
.boss-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.boss-meta {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

/* ---------- 混合面试 ---------- */
.mix-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.mix-row {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.mix-row.hot {
  background: linear-gradient(160deg, #fef3c7, #fde68a);
  border-color: #fbbf24;
}
.mix-emoji { font-size: 40rpx; }
.mix-info { flex: 1; }
.mix-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mix-hot {
  font-size: 18rpx;
  font-weight: 900;
  color: #fff;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}
.mix-desc {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 0.5rpx;
}
.mix-go {
  font-size: 36rpx;
  color: #cbd5e1;
  font-weight: 300;
}
.mix-row.hot .mix-go { color: #f59e0b; }

/* ---------- 章节面试 ---------- */
.ch-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ch-row {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ch-num {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(160deg, #f1f5f9, #e2e8f0);
  color: #475569;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ch-info { flex: 1; }
.ch-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
  letter-spacing: 0.5rpx;
}
.ch-sub {
  font-size: 21rpx;
  color: #94a3b8;
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ch-right { flex-shrink: 0; }
.ch-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  letter-spacing: 0.5rpx;
}
.ch-badge.pass {
  color: #059669;
  background: #d1fae5;
}
.ch-badge.doing {
  color: #d97706;
  background: #fef3c7;
}

.tail { height: 60rpx; }
