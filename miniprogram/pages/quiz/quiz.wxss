.wrap { padding: 24rpx 24rpx 60rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "HarmonyOS Sans SC", "MiSans", "OPPO Sans", "HONOR Sans", "Source Han Sans SC",
    "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== Hero ===== */
.hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #111827 0%, #312e81 55%, #6d28d9 100%);
  border-radius: 28rpx; padding: 38rpx 34rpx 34rpx; color: #ffffff; margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(49, 46, 129, 0.32);
}
.hero-deco { position: absolute; border-radius: 50%; background: #ffffff; opacity: 0.1; }
.hero-deco.d1 { width: 240rpx; height: 240rpx; right: -70rpx; top: -90rpx; }
.hero-deco.d2 { width: 130rpx; height: 130rpx; right: 110rpx; bottom: -50rpx; opacity: 0.06; }
.hero-badge {
  display: inline-block; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.16); border-radius: 99rpx; padding: 8rpx 20rpx;
}
.hero-title { font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; margin-top: 18rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.78; margin-top: 12rpx; line-height: 1.5; }

.hero-stats { display: flex; align-items: center; margin-top: 30rpx; background: rgba(255,255,255,0.10); border-radius: 18rpx; padding: 20rpx 0; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 34rpx; font-weight: 800; }
.stat-num.hl { color: #fde047; }
.stat-max { font-size: 22rpx; font-weight: 400; opacity: 0.6; }
.stat-label { font-size: 22rpx; opacity: 0.72; margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 44rpx; background: rgba(255,255,255,0.2); }

/* ===== 面试官阵容 ===== */
.panel-card {
  background: #ffffff; border-radius: 22rpx; padding: 26rpx 24rpx 20rpx; margin-bottom: 26rpx;
  box-shadow: 0 2rpx 14rpx rgba(15, 23, 42, 0.06);
}
.panel-title { font-size: 24rpx; font-weight: 700; color: #64748b; letter-spacing: 1rpx; margin-bottom: 20rpx; }
.panel-tip { font-size: 20rpx; font-weight: 400; color: #b6bfcd; margin-left: 12rpx; }

/* 风格选择卡 */
.style-grid { display: flex; gap: 14rpx; }
.style-card {
  flex: 1; text-align: center; padding: 20rpx 8rpx 16rpx; border-radius: 18rpx;
  background: #f8fafc; border: 2rpx solid transparent; position: relative;
  transition: all .18s ease;
}
.style-card.active { background: #eef4ff; border-color: #2563eb; box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, .16); }
.sc-emoji { font-size: 34rpx; line-height: 1.2; }
.sc-name { font-size: 24rpx; font-weight: 700; color: #1f2937; margin-top: 8rpx; }
.style-card.active .sc-name { color: #2563eb; }
.sc-desc { font-size: 18rpx; color: #9aa4b2; margin-top: 6rpx; line-height: 1.4; }
.sc-tag {
  display: inline-block; font-size: 17rpx; font-weight: 700; color: #64748b;
  background: #eef1f5; border-radius: 99rpx; padding: 2rpx 14rpx; margin-top: 10rpx;
}
.style-card.active .sc-tag { background: #2563eb; color: #ffffff; }
.boss-badge {
  display: inline-block; font-size: 17rpx; font-weight: 800; color: #dc2626;
  background: #fef2f2; border: 1rpx solid #fecaca; border-radius: 8rpx;
  padding: 0 10rpx; margin-left: 10rpx; vertical-align: 2rpx;
}
.panel-row { display: flex; }
.panel-iv { flex: 1; text-align: center; padding: 0 6rpx; }
.pi-avatar {
  width: 84rpx; height: 84rpx; border-radius: 24rpx; margin: 0 auto 12rpx;
  color: #ffffff; font-size: 34rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.16);
}
.pi-name { font-size: 25rpx; font-weight: 700; color: #1f2937; }
.pi-title { font-size: 19rpx; color: #9aa4b2; margin-top: 6rpx; line-height: 1.35; }

/* ===== 场次列表 ===== */
.list-head { display: flex; align-items: baseline; justify-content: space-between; margin: 0 6rpx 18rpx; }
.lh-title { font-size: 28rpx; font-weight: 700; color: #1f2937; }
.lh-tip { font-size: 21rpx; color: #9aa4b2; }

.session {
  display: flex; align-items: center; background: #ffffff; border-radius: 20rpx;
  padding: 22rpx; margin-bottom: 18rpx;
  box-shadow: 0 2rpx 14rpx rgba(15, 23, 42, 0.06);
  animation: session-in 0.32s ease both;
}
@keyframes session-in { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
.session.is-locked { background: #f8fafc; }

.s-no {
  width: 74rpx; height: 74rpx; border-radius: 20rpx; flex-shrink: 0;
  text-align: center; line-height: 74rpx; font-size: 27rpx; font-weight: 800; color: #ffffff;
}
.s-no.open { background: linear-gradient(135deg, #6366f1, #4f46e5); box-shadow: 0 6rpx 16rpx rgba(79, 70, 229, 0.3); }
.s-no.done { background: linear-gradient(135deg, #22c55e, #16a34a); }
.s-no.lock { background: #cbd5e1; font-size: 30rpx; }

.s-main { flex: 1; overflow: hidden; padding: 0 18rpx; }
.s-title { font-size: 27rpx; font-weight: 700; color: #111827; line-height: 1.4; }
.is-locked .s-title { color: #94a3b8; }
.s-meta { display: flex; align-items: center; flex-wrap: wrap; font-size: 21rpx; color: #9aa4b2; margin-top: 10rpx; }
.s-iv { display: flex; align-items: center; }
.s-iv-avatar {
  width: 30rpx; height: 30rpx; border-radius: 9rpx; margin-right: 8rpx;
  color: #ffffff; font-size: 18rpx; text-align: center; line-height: 30rpx;
}
.s-sep { margin: 0 8rpx; }
.s-note { font-size: 21rpx; color: #16a34a; margin-top: 8rpx; }
.s-note.warn { color: #ef4444; }

.s-right { flex-shrink: 0; width: 150rpx; text-align: center; }
.s-grade { font-size: 44rpx; font-weight: 900; line-height: 1.1; }
.s-grade.g3 { color: #f59e0b; }
.s-grade.g2 { color: #2563eb; }
.s-grade.g1 { color: #0d9488; }
.s-grade.g0 { color: #ef4444; }
.s-grade.none { font-size: 22rpx; font-weight: 600; color: #cbd5e1; line-height: 48rpx; }
.s-btn { margin-top: 10rpx; font-size: 22rpx; font-weight: 700; border-radius: 99rpx; padding: 10rpx 0; }
.s-btn.go { background: #eff6ff; color: #2563eb; }
.s-btn.again { background: #f5f3ff; color: #7c3aed; }
.s-btn.lock { background: #f1f5f9; color: #b6bfcd; }

.footer { text-align: center; font-size: 21rpx; color: #a3adbd; margin-top: 26rpx; line-height: 1.6; }
