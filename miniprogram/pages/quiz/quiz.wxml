<view class="page">

  <!-- 顶部 Hero：紧扣教程 -->
  <view class="hero">
    <view class="hero-badge">📚 教程配套面试</view>
    <view class="hero-title">学完一章</view>
    <view class="hero-title">来场面试</view>
    <view class="hero-sub">28 章教程题库 · 4 种面试官风格 · 逐章检验掌握度</view>
    <view class="hero-stats">
      <view class="stat">
        <text class="stat-num">{{chapterCount}}</text>
        <text class="stat-key">章节面试</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{passedCount}}</text>
        <text class="stat-key">已通关</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{avgRate}}%</text>
        <text class="stat-key">平均正确率</text>
      </view>
    </view>
  </view>

  <!-- 语音讲解入口：面试区域上方 -->
  <view class="listen-entry" bindtap="goListen" hover-class="press">
    <view class="listen-left">
      <view class="listen-emoji">🎧</view>
      <view class="listen-info">
        <view class="listen-title">面试题讲解</view>
        <view class="listen-sub">老师念题 · 同学讲解 · 可续听</view>
      </view>
    </view>
    <view class="listen-go">去听 ›</view>
  </view>

  <!-- 面试官风格：紧凑横排 -->
  <view class="sec">
    <view class="sec-title">面试官风格</view>
    <scroll-view class="style-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="style-row">
        <view
          wx:for="{{styles}}"
          wx:key="id"
          class="style-chip {{style === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="pickStyle"
          hover-class="press"
        >
          <text class="style-emoji">{{item.emoji}}</text>
          <text class="style-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="style-tip">{{curStyle.emoji}} {{curStyle.name}} · {{curStyle.tagline}}</view>
  </view>

  <!-- 大厂真题 -->
  <view class="sec">
    <view class="sec-title">🏢 大厂真题场</view>
    <view class="boss-grid">
      <view
        wx:for="{{bossList}}"
        wx:key="quizKey"
        class="boss-card"
        data-key="{{item.quizKey}}"
        data-title="{{item.title}}"
        bindtap="startChapter"
        hover-class="press"
      >
        <view class="boss-emoji">{{item.emoji}}</view>
        <view class="boss-name">{{item.name}}</view>
        <view class="boss-meta">{{item.count}} 题</view>
      </view>
    </view>
  </view>

  <!-- 混合面试 -->
  <view class="sec">
    <view class="sec-title">🎲 混合面试</view>
    <view class="mix-list">
      <view
        wx:for="{{mixList}}"
        wx:key="id"
        class="mix-row {{item.hot ? 'hot' : ''}}"
        data-id="{{item.id}}"
        bindtap="startMix"
        hover-class="press"
      >
        <view class="mix-emoji">{{item.emoji}}</view>
        <view class="mix-info">
          <view class="mix-name">
            {{item.name}}
            <text wx:if="{{item.hot}}" class="mix-hot">HOT</text>
          </view>
          <view class="mix-desc">{{item.desc}}</view>
        </view>
        <view class="mix-go">›</view>
      </view>
    </view>
  </view>

  <!-- 章节面试：教程主体 -->
  <view class="sec">
    <view class="sec-title">📚 章节面试 <text class="sec-sub">跟教程进度走</text></view>
    <view class="ch-list">
      <view
        wx:for="{{chapters}}"
        wx:key="key"
        class="ch-row"
        data-key="{{item.quizKey}}"
        data-title="{{item.title}}"
        bindtap="startChapter"
        hover-class="press"
      >
        <view class="ch-num">{{item.num}}</view>
        <view class="ch-info">
          <view class="ch-title">{{item.shortTitle}}</view>
          <view class="ch-sub">{{item.count}} 题 · {{item.subtitle}}</view>
        </view>
        <view class="ch-right">
          <view wx:if="{{item.passed}}" class="ch-badge pass">✓ {{item.rate}}%</view>
          <view wx:elif="{{item.done}}" class="ch-badge doing">· {{item.rate}}%</view>
          <view wx:else class="ch-badge">未面</view>
        </view>
      </view>
    </view>
  </view>

  <view class="tail"></view>
</view>
