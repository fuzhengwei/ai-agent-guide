<view class="map-page" style="background: {{bgGrad}};">

  <!-- 顶部状态条 -->
  <view class="topbar">
    <view class="topbar-left">
      <text class="topbar-title">🏝️ 勇者冒险岛</text>
      <text class="topbar-sub">已通关 {{cleared}} / 28 关</text>
    </view>
    <view class="topbar-right">
      <view class="topbar-btn" bindtap="resetSave" hover-class="btn-press">🔄</view>
    </view>
  </view>

  <!-- 地图长卷 -->
  <scroll-view
    class="map-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{scrollTopV}}"
    scroll-with-animation
  >
    <view class="map-canvas" style="height: {{mapH * 1.5}}rpx;">

      <!-- 区域背景色带（7 段纵向过渡） -->
      <view class="band" wx:for="{{7}}" wx:key="*this" style="top: {{index * (mapH * 1.5 / 7)}}rpx; height: {{mapH * 1.5 / 7 + 4}}rpx;"></view>

      <!-- 漂浮云朵 -->
      <view
        wx:for="{{clouds}}"
        wx:key="index"
        class="cloud c{{item.d}}"
        style="left: {{item.x}}%; top: {{item.y * 1.5}}rpx; font-size: {{52 * item.s}}rpx;"
      >☁️</view>

      <!-- 山路 SVG -->
      <svg class="map-path" viewBox="0 0 100 {{mapH}}" preserveAspectRatio="none">
        <!-- 土黄色路基 -->
        <path d="{{pathD}}" fill="none" stroke="#e8c97f" stroke-width="7" stroke-linecap="round" />
        <!-- 白色虚线车道线 -->
        <path d="{{pathD}}" fill="none" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="3,4" opacity="0.85" />
      </svg>

      <!-- 路边装饰 -->
      <view
        wx:for="{{decors}}"
        wx:key="index"
        class="decor"
        style="left: {{item.x}}%; top: {{item.y * 1.5}}rpx; font-size: {{item.s ? 44 * item.s : 44}}rpx;"
      >{{item.icon}}</view>

      <!-- 终点王冠 -->
      <view
        class="crown {{crown.lit ? 'lit' : ''}}"
        style="left: {{crown.px}}%; top: {{crown.py * 1.5}}rpx;"
      >👑</view>

      <!-- 宝箱 -->
      <view
        wx:for="{{chests}}"
        wx:key="index"
        class="chest {{item.opened ? 'opened' : ''}}"
        style="left: {{item.x}}%; top: {{item.y * 1.5}}rpx;"
        data-i="{{index}}"
        bindtap="tapChest"
        hover-class="node-press"
      >{{item.opened ? '🎁' : '📦'}}</view>

      <!-- 关卡节点 -->
      <view
        wx:for="{{levels}}"
        wx:key="idx"
        class="node {{item.state}}"
        style="left: {{item.px}}%; top: {{item.py * 1.5}}rpx;"
        data-idx="{{item.idx}}"
        bindtap="tapLevel"
        hover-class="node-press"
      >
        <view class="node-bubble">
          <text wx:if="{{item.state === 'locked'}}" class="node-lock">🔒</text>
          <text wx:elif="{{item.state === 'cleared'}}" class="node-star">⭐</text>
          <text wx:else class="node-num">{{item.num}}</text>
        </view>
        <view class="node-flag">{{item.icon}}</view>
        <view class="node-name {{item.state}}">{{item.name}}</view>
        <view wx:if="{{item.state === 'current'}}" class="node-pulse"></view>
      </view>

      <!-- 小狐狸勇者 -->
      <view class="fox" style="left: {{fox.x}}%; top: {{fox.y * 1.5}}rpx;">🦊</view>

      <!-- 底部起点留白 -->
      <view class="map-tail"></view>
    </view>
  </scroll-view>

  <!-- 全部通关横幅 -->
  <view wx:if="{{isAllClear}}" class="allclear">
    🎉 你已登顶雪山王城，全部 28 关通关！
  </view>

  <!-- 关卡详情弹窗 -->
  <view wx:if="{{popup}}" class="popup-mask" bindtap="closePopup">
    <view class="popup-card" catchtap="noop">
      <view class="popup-head" style="background: linear-gradient(135deg, {{popup.zoneLine}}, #ffb347);">
        <text class="popup-icon">{{popup.icon}}</text>
        <view class="popup-head-text">
          <text class="popup-name">第 {{popup.num}} 关 · {{popup.name}}</text>
          <text class="popup-monster">守关小怪 {{popup.monster}} 出没</text>
        </view>
      </view>

      <view class="popup-body">
        <view class="popup-meta">
          <view class="meta-chip">📝 {{popup.poolCount}} 题池 · 抽 10 题</view>
          <view class="meta-chip">{{popup.cleared ? '⭐ 已通关 · 自由练习' : '🎯 全对才能过关'}}</view>
          <view wx:if="{{popup.bestScore}}" class="meta-chip gold">🏅 最佳 {{popup.bestScore}} 分</view>
        </view>

        <view wx:if="{{popup.tip}}" class="popup-tip">
          <view class="popup-tip-label">💡 本关小贴士（来自题库真题）</view>
          <view class="popup-tip-q">{{popup.tip.question}}</view>
          <view class="popup-tip-a">{{popup.tip.answer}}</view>
        </view>

        <view class="popup-btns">
          <button class="btn ghost" hover-class="btn-hover" bindtap="closePopup">再逛逛</button>
          <button class="btn primary" hover-class="btn-hover" bindtap="startLevel">
            {{popup.cleared ? '🎮 再玩一次' : '⚔️ 开始挑战'}}
          </button>
        </view>
      </view>
    </view>
  </view>

</view>
