<view class="page">

  <!-- 顶部 Hero -->
  <view class="hero">
    <view class="hero-badge">🎤 AI Agent 面试间</view>
    <view class="hero-title">来一场真实的</view>
    <view class="hero-title">技术面试</view>
    <view class="hero-sub">7 位面试官 · 4 种风格 · 还原大厂压力面</view>
    <view class="hero-stats">
      <view class="stat">
        <text class="stat-num">{{totalCount}}</text>
        <text class="stat-key">面试场次</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{passedCount}}</text>
        <text class="stat-key">已通关</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{avgRate}}%</text>
        <text class="stat-key">平均正确率</text>
      </view>
    </view>
  </view>

  <!-- 面试官风格选择 -->
  <view class="sec">
    <view class="sec-title">选择面试官风格</view>
    <view class="style-grid">
      <view
        wx:for="{{styles}}"
        wx:key="id"
        class="style-card {{style === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="pickStyle"
        hover-class="press"
      >
        <view class="style-emoji">{{item.emoji}}</view>
        <view class="style-name">{{item.name}}</view>
        <view class="style-desc">{{item.desc}}</view>
        <view wx:if="{{style === item.id}}" class="style-check">✓</view>
      </view>
    </view>
    <view class="style-tip">已选 <text class="hl">{{curStyle.name}}</text> · {{curStyle.tagline}}</view>
  </view>

  <!-- 大厂真题 -->
  <view class="sec">
    <view class="sec-title">🏢 大厂真题场</view>
    <view class="boss-row">
      <view
        wx:for="{{bossList}}"
        wx:key="key"
        class="boss-card"
        data-key="{{item.quizKey}}"
        data-title="{{item.title}}"
        bindtap="startChapter"
        hover-class="press"
      >
        <view class="boss-emoji">{{item.emoji}}</view>
        <view class="boss-name">{{item.name}}</view>
        <view class="boss-desc">{{item.desc}}</view>
        <view class="boss-meta">{{item.count}} 题 · 真题还原</view>
      </view>
    </view>
  </view>

  <!-- 混合面试 -->
  <view class="sec">
    <view class="sec-title">🎲 混合面试</view>
    <view class="mix-list">
      <view
        wx:for="{{mixList}}"
        wx:key="id"
        class="mix-row {{item.hot ? 'hot' : ''}}"
        data-id="{{item.id}}"
        bindtap="startMix"
        hover-class="press"
      >
        <view class="mix-emoji">{{item.emoji}}</view>
        <view class="mix-info">
          <view class="mix-name">
            {{item.name}}
            <text wx:if="{{item.hot}}" class="mix-hot">HOT</text>
          </view>
          <view class="mix-desc">{{item.desc}}</view>
        </view>
        <view class="mix-go">›</view>
      </view>
    </view>
  </view>

  <!-- 章节面试 -->
  <view class="sec">
    <view class="sec-title">📚 章节面试 <text class="sec-sub">按课程顺序逐章突破</text></view>
    <view class="ch-list">
      <view
        wx:for="{{chapters}}"
        wx:key="key"
        class="ch-row"
        data-key="{{item.quizKey}}"
        data-title="{{item.title}}"
        bindtap="startChapter"
        hover-class="press"
      >
        <view class="ch-num">{{item.num}}</view>
        <view class="ch-info">
          <view class="ch-title">{{item.shortTitle}}</view>
          <view class="ch-sub">{{item.count}} 题 · {{item.subtitle}}</view>
        </view>
        <view class="ch-right">
          <view wx:if="{{item.passed}}" class="ch-badge pass">✓ {{item.rate}}%</view>
          <view wx:elif="{{item.done}}" class="ch-badge doing">· {{item.rate}}%</view>
          <view wx:else class="ch-badge">未面</view>
        </view>
      </view>
    </view>
  </view>

  <view class="tail"></view>
</view>
